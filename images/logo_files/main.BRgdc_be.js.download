,description:"Kích thước thiết kế tối thiểu là 30px và tối đa là 3000px.",create:"tạo nên",back:"Quay lại thiết kế"},createNewPopup:{title:"Tạo thiết kế mới",search:"tìm kiếm",empty:"Không có kết quả nào cho “{{search}}”",createDesignWithCustomSize:"Tạo thiết kế với kích thước tùy chỉnh",types:{logo:"biểu trưng",businessCard:"Danh thiếp",letterhead:"Tiêu đề thư",letterheadDocx:"Tiêu đề thư DOCX",emailSignature:"Chữ ký email",instagramPost:"Bài đăng trên Instagram",facebookCover:"Ảnh bìa Facebook",createNewDesign:"Tạo thiết kế mới",facebookPost:"Bài đăng trên Facebook",instagramStory:"Câu chuyện trên Instagram",twitterProfile:"Hồ sơ Twitter",youtubeProfile:"Hồ sơ YouTube",youtubeCover:"Bìa YouTube",facebookProfile:"Hồ sơ Facebook",instagramProfile:"Hồ sơ Instagram",envelope:"phong bì",wallpaper:"hình nền",watermark:"Hình mờ",custom:"Kích thước tùy chỉnh",vkCover:"Bìa VK",vkProfile:"Hồ sơ VK",linkedinCover:"Bìa LinkedIn",linkedinProfile:"Hồ sơ LinkedIn",twitterPost:"Bài đăng X",twitterCover:"Bìa X",favicon:"Biểu tượng yêu thích"}},designTypes:{title:"Bắt đầu với một cái gì đó mới",tabs:{recommended:"Khuyến khích",socialMedia:"phương tiện truyền thông xã hội",business:"việc kinh doanh",ai:"trợ lý ai"},types:{logo:"biểu trưng",businessCard:"Danh thiếp",letterhead:"Tiêu đề thư",emailSignature:"Chữ ký email",instagramPost:"Bài đăng trên Instagram",facebookCover:"Ảnh bìa Facebook",createNewDesign:"Tạo thiết kế mới",facebookPost:"Bài đăng trên Facebook",instagramStory:"Câu chuyện Instagram",twitterProfile:"Hồ sơ Twitter",youtubeProfile:"Hồ sơ YouTube",facebookProfile:"Hồ sơ Facebook",instagramProfile:"Hồ sơ Instagram",envelope:"phong bì",wallpaper:"hình nền",watermark:"Hình mờ",aiPrompt1:"Tạo nhiệm vụ để khởi chạy dự án",aiPrompt2:"Xác định giá trị sản phẩm",aiPrompt3:"Chuẩn bị tóm tắt nhà thầu",aiPrompt4:"Tạo chiến lược nội dung",aiPrompt5:"Viết bài đăng trên Instagram / VK",aiPrompt6:"Thiết kế kết cấu hạ cánh"}},confirmUpgradePopup:{title:"Bạn đang chuyển đổi kế hoạch của mình",descriptionStripe:"Hôm nay, bạn sẽ nhận được khoản phí theo tỷ lệ cho những ngày còn lại trong chu kỳ thanh toán này. Bắt đầu từ chu kỳ thanh toán tiếp theo, tài khoản của bạn sẽ bị tính toàn bộ chi phí cho gói đăng ký mới của bạn.",descriptionOther:"Để thay đổi gói cước, bạn sẽ cần mua một gói đăng ký mới. <b>Chúng tôi sẽ hoàn lại số dư còn lại của gói cước hiện tại của bạn</b> , được tính dựa trên số ngày còn lại trong kỳ thanh toán. Việc hoàn lại tiền sẽ được xử lý trong vòng một ngày làm việc.",info:"Nhấp vào Chuyển đổi gói để tiếp tục",cancel:"Hủy bỏ",confirm:"Chuyển đổi kế hoạch"},editorShowcases:{greatLogosTitle:"Logo trông tuyệt vời ở mọi định dạng – vật lý và kỹ thuật số",greatLogosSubtitle:"Logo của chúng tôi được thiết kế để tỏa sáng trên mọi loại phương tiện truyền thông. Cho dù bạn cần một logo nổi bật cho danh thiếp, tiêu đề thư hoặc tờ rơi, hay một thiết kế năng động và bắt mắt cho trang web, phương tiện truyền thông xã hội hoặc ứng dụng di động, nền tảng của chúng tôi đảm bảo logo của bạn duy trì được tính toàn vẹn và sức hấp dẫn trực quan.",newIdeasTitle:"Bắt đầu triển khai ý tưởng mới ngay hôm nay",newIdeasSubtitle:"Bạn đã tạo ra một logo đặc biệt, hoàn toàn nắm bắt được bản chất thương hiệu của bạn. Bây giờ là lúc hiện thực hóa tầm nhìn của bạn bằng cách giới thiệu logo mới. Bắt đầu triển khai các ý tưởng sáng tạo của bạn ngay hôm nay và theo dõi thương hiệu của bạn phát triển!",customizeLogoBtn:"Tùy chỉnh logo của bạn ngay bây giờ",colorsTitle:"Màu sắc Logo của bạn",colorsSubtitle:"Màu sắc trong logo đóng vai trò quan trọng trong việc định hình nhận thức về thương hiệu. Bằng cách lựa chọn và kết hợp màu sắc một cách cẩn thận, các thương hiệu có thể truyền tải thông điệp của mình một cách hiệu quả, gợi lên những cảm xúc mong muốn và tạo nên mối liên hệ sâu sắc hơn với đối tượng mục tiêu của mình",typoTitle:"kiểu chữ",typoSubtitle:"Việc lựa chọn phông chữ cho logo tạo ra ấn tượng đầu tiên và truyền tải tính cách của thương hiệu. Điều cần thiết là chọn phông chữ mà bạn thích và phù hợp với các giá trị và cảm xúc của thương hiệu. Sự phù hợp này giúp thúc đẩy kết nối chân thực với khách hàng của bạn."},paymentNew:{title:"Kết thúc đặt hàng",yourOrder:"Đơn hàng của bạn",benefits:{oneTime:"Thanh toán một lần",recurrent:"Thanh toán định kỳ",refund:"Đảm bảo hoàn tiền",support:"Hỗ trợ miễn phí"},haveCoupon:"Có phiếu giảm giá?",enterCoupon:"Nhập phiếu giảm giá của bạn",apply:"Áp dụng",subtotal:"Tổng phụ",discount:"giảm giá",total:"tổng cộng",paymentDetails:"Chi tiết thanh toán",express:"Thanh toán nhanh",or:"hoặc",choosePaymentMethod:"Lựa chọn hình thức thanh toán",creditCard:"thẻ tín dụng",payWith:"Thanh toán bằng",info:"Bằng cách cung cấp thông tin thẻ của mình, bạn cho phép Turbologo tính phí thẻ của bạn cho các khoản thanh toán trong tương lai theo các điều khoản của họ.",ssl:"Được bảo mật bằng mã hóa SSL 256-bit",threeMonthsPeriod:"Thời gian chỉnh sửa 3 tháng",oneYearPeriod:"Thời gian chỉnh sửa 1 năm",renews:"Gia hạn vào {{renewDate}}",packages:{basic:"Gói rút gọn",optima:"Gói tiêu chuẩn",business:"Kế hoạch kinh doanh",subscription_lite:"Gói rút gọn",subscription_basic:"Gói tiêu chuẩn",subscription_premium:"Kế hoạch kinh doanh"},couponApplied:"Mã giảm giá của bạn đã được áp dụng thành công!"},settingsBillingUnsubscribePopup:{title:"Hủy đăng ký",description1:"Nếu bạn hủy ngay bây giờ, bạn vẫn có toàn quyền truy cập vào Turbologo cho đến khi kết thúc chu kỳ thanh toán của bạn trên",description2:"Sau đó, gói dịch vụ của bạn sẽ được hạ cấp xuống gói miễn phí.",infoTitle:"Bạn sẽ không thể:",info1:"Giữ lại thiết kế và tài sản của bạn. <b>Chúng có thể bị xóa sau 90 ngày</b>",info2:"<b>Tải xuống thiết kế của bạn ở bất kỳ định dạng nào</b>",cancel:"Giữ đăng ký",confirm:"Tiến hành hủy bỏ",subscriptionCanceledTitle:"Đăng ký đã bị hủy",subscriptionCanceledDescription:"Bạn sẽ được hưởng các lợi ích của Turbologo cho đến ngày ghi nợ tiếp theo.",close:"Đóng"},tariffItemSubscription:{plans:{monthly:{Standard:{name:"Tiêu chuẩn",description:"Tất cả các tệp logo + quyền truy cập mở rộng vào các dịch vụ AI",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},Business:{name:"việc kinh doanh",description:"Mọi thứ để bắt đầu kinh doanh + quyền truy cập nâng cao vào dịch vụ AI của chúng tôi",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},yearly:{Standard:{name:"Tiêu chuẩn",description:"Tất cả các tệp logo + quyền truy cập mở rộng vào các dịch vụ AI",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},Business:{name:"việc kinh doanh",description:"Mọi thứ để bắt đầu kinh doanh + quyền truy cập nâng cao vào dịch vụ AI của chúng tôi",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}}},getPackage:"Tiếp tục",cancel:"Hủy bất cứ lúc nào",popular:"Phổ biến nhất",best:"Giá trị tốt nhất",perMonth:"/ mỗi tháng",perYear:"/ mỗi năm",current:"Kế hoạch hiện tại",update:"Cập nhật"},tariffSwitcherSubscription:{monthly:"hàng tháng",yearly:"Hàng năm",save:"Tiết kiệm {{discount}}%"},homeAuthorizedHeader:{logoAndDesign:"Logo và thiết kế",turboChat:"Trò chuyện AI",websites:"Trang web",brandKit:"Bộ sản phẩm thương hiệu",nameGenerator:"Trình tạo tên",pricing:"Định giá",reviews:"Đánh giá",contact:"Liên lạc",aboutUs:"Về chúng tôi",more:"Hơn",tooltipAi:{title:"Trợ lý AI của bạn trong việc tạo văn bản cho doanh nghiệp!",description:"Văn bản cho trang đích, thẻ sản phẩm, bản tin email, tất cả chỉ trong vài giây. Hãy dùng thử miễn phí ngay bây giờ 🚀",ok:"Hiểu rồi"},services:"Dịch vụ",upgrade:"Nâng cấp tài khoản"},upgradePopupDownload:{title:"Chọn màu sắc, định dạng và kích cỡ khác nhau",descriptions:{highQuality:{first:"chất lượng cao",second:"hình ảnh logo với nền trong suốt"},formats:{first:"Tệp SVG và PDF",second:"phù hợp cho các loại mục đích sử dụng khác nhau"},newVersions:{first:"Tạo nên",second:"phiên bản mới",third:"logo của bạn với",fourth:"thay đổi không giới hạn"},support:"Hỗ trợ miễn phí"},upgrade:"nâng cấp"},tipsNew:{instantDownload:{tip:"Tải về ngay lập tức"},oneLogoFile:{tip:"Một tập tin logo (Không trong suốt)",title1:"Một tập tin biểu tượng",description:"Gói Lite bao gồm một tệp hình ảnh logo ở định dạng PNG với chiều rộng 1000px. Hình ảnh này trông giống như hình ảnh đầu tiên bạn có thể thấy khi xem trước. Lưu ý rằng hình ảnh có nền trong suốt không được bao gồm trong gói đó.",title2:"Nó dùng để làm gì?",li1:"Tải nó lên bất kỳ dịch vụ nào không yêu cầu độ phân giải hình ảnh cụ thể hoặc nền trong suốt",li2:"Bạn có thể tải nó lên làm ảnh hồ sơ của công ty bạn",li3:"Sử dụng nó làm bản phác thảo logo của bạn và hiển thị cho nhà thiết kế"},makeChanges:{tip:"Thực hiện thay đổi và tải xuống lại",title:"Thực hiện thay đổi không giới hạn cho logo của bạn",description:"Với đăng ký, bạn có thể thay đổi và tải xuống các tập tin logo không giới hạn số lần. Bắt đầu sử dụng logo của bạn ngay hôm nay và thực hiện bất kỳ thay đổi nào trong tương lai",li1:"Thay đổi logo miễn phí không giới hạn",li2:"Tải logo ngay",li3:"Thực hiện bất kỳ thay đổi trực tuyến"},highQuality:{tip:"Nhiều tệp logo chất lượng cao",title1:"Hình ảnh logo chất lượng cao và nền trong suốt",description:"Bạn sẽ nhận được các tệp logo chất lượng cao (2000px), bao gồm:",li1:"Logo có màu nền gốc",li2:"Logo có nền trong suốt",title2:"Nó dùng để làm gì?",li3:"Sử dụng logo có nền trong suốt trên bất kỳ hình ảnh nào.",li4:"Sử dụng hình ảnh logo chất lượng cao trên các dịch vụ truyền thông xã hội",li5:"Chèn logo của bạn vào bất kỳ đồ họa nào"},printReady:{tip:"Sẵn sàng in (PDF, SVG)",title1:"Tệp vectơ",description1:"Bạn sẽ nhận được các tệp SVG vector có thể được mở trong phần mềm thiết kế đồ họa bởi bất kỳ nhà thiết kế nào. Đây là 'tập tin nguồn' của logo của bạn.",title2:"Nó dùng để làm gì?",description2:"Thông thường các nhà thiết kế hoặc kiểu chữ yêu cầu các tệp vector. Bạn sẽ nhận được tập hợp các tệp vectơ mà bất kỳ nhà thiết kế hoặc nhà in nào cũng có thể sử dụng.",li1:"In logo của bạn trên mọi bề mặt và ở mọi kích thước mà không làm giảm chất lượng",li2:"Sử dụng logo của bạn cho các công việc thiết kế tiếp theo như bảng hiệu, menu, tờ rơi, v.v.",li3:"Chỉnh sửa logo của bạn trong phần mềm thiết kế chuyên nghiệp, như Photoshop hoặc CorelDraw"},transparentBackground:{tip:"Nền trong suốt"},unlimitedLogos:{tip:"Tạo thêm logo không giới hạn",title:"Tạo phiên bản mới của logo",description:"Bạn có thể sử dụng trình tạo logo để tạo các phiên bản logo mới",li1:"Tạo thiết kế logo mới miễn phí",li2:"Tải xuống bất kỳ logo nào bất kỳ lúc nào ngay cả khi đăng ký kết thúc",li3:"Tùy chỉnh thiết kế logo cho các nền tảng khác nhau"},fullCommercial:{tip:"Quyền thương mại đầy đủ",title1:"Toàn quyền sở hữu bản quyền",description1:"Bạn sở hữu toàn quyền sở hữu bản quyền đối với biểu trưng của mình. Turbologo chuyển tất cả các quyền độc quyền của bạn về logo.",title2:"Nó dùng để làm gì?",description2:"Turbologo không thể sử dụng hoặc sao chép logo của bạn dưới bất kỳ hình thức nào mà không có sự đồng ý của bạn."},socialPost:{tip:"Thiết kế bài đăng trên mạng xã hội"},socialProfile:{tip:"Thiết kế hồ sơ xã hội"},businessCard:{tip:"Danh thiếp",title:"Danh thiếp",description:"Truy cập ngay vào hơn 20 mẫu danh thiếp và cá nhân có logo và thông tin của bạn ở định dạng PDF",li1:"Thiết kế có thể tùy chỉnh",li2:"Logo, tên, vị trí, địa chỉ liên hệ và thông tin bổ sung của bạn",li3:"Cập nhật và tải xuống trực tuyến"},emailSignature:{tip:"Chữ ký email",title:"Chữ ký email",description:"Nhận chữ ký email có thương hiệu được điền sẵn logo và thông tin công ty của bạn",li1:"Thiết kế có thể tùy chỉnh",li2:"Logo, tên, vị trí, trang web, địa chỉ liên hệ và thông tin bổ sung của bạn",li3:"Cập nhật và sao chép trực tuyến"},brandIdentity:{tip:"nhận diện thương hiệu",title:"nhận diện thương hiệu",description:"Nhận thông tin đầy đủ về phông chữ và màu sắc được sử dụng trong logo. Ngoài ra, hãy tải xuống logo với nhiều biến thể màu sắc.",li1:"Nhận tên phông chữ logo",li2:"Nhận mã màu log