o",yearly:"/year",save:"Save {{discount}}%",select:"Continue",coupon:"Apply coupon",oneTime:"One-time payment",subscription_lite:{name:"Lite",description:"One logo in low quality",about:"For quick start"},subscription_basic:{name:"Standard",description:"All logo files + extended access to AI services",about:"For quick start",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},subscription_premium:{name:"Business",description:"Everything to start a business + advanced access to our AI service",about:"For businesses and startups",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},coupon:{title:"Apply coupon",title_applied:"Coupon applied!",code:"Coupon code",button:"Apply coupon",close:"Close"},faq:{title:"Frequently Asked Questions",freeDownload:{question:"Can I download a logo for free?",answer:"We provide unlimited logo variations for free, but we offer only paid download. Save your time and money and download logo right now."},changeLogoAfterPurchase:{question:"Can I change a logo after purchase?",answer:"Yes, you can change the logo unlimitedly after purchase during the plan period."},createLogoAfterPurchase:{question:"Can I create more logos after purchase?",answer:"Yes, you can create an unlimited number of logos and download them according to the terms and term of your plan. One plan applies to all logos you create, change or download"},whatPlanToChooseForPrinting:{question:"Which plan should I choose if I need high quality logos for printing?",answer:"You can choose between Standard and Business plans. These plans will allow you to download logo files in high quality and optimized for printing."},changeSize:{question:"Can I change the logo size after purchase?",answer:"You can change the design dimensions (width and height) if you choose the Business plan"},fileFormats:{question:"Which formats are available to download?",answer:"High quality PNG, vector SVG and PDF formats are available to download."},copyright:{question:"Do I own all the right after purchase?",answer:"Yes you'll own full commercial rights even when edit or subscription time is over."},fontsCommercial:{question:"Can I use fonts from my logo for commercial usage?",answer:"Yes, our fonts are available for commercial usage. You can get font names if you would choose brand-kit subscription or Business package."},freeSupport:{question:"Do you offer support?",answer:"Yes. Our support team is available through online chat or email every day."},oneTimeFeeVsSubscription:{question:"What is the difference between one-time fee and brandkit subscription?",answer:"With one-time fee package you can work just with one logo at time. With brand-kit subscription you can create and download unlimited versions of logo without additional cost."},subscriptionRecurringCharge:{question:"Is this a one-time payment?",answer:"Yes. It's a one-time payment and not recurring."},subscriptionPremiumCustomizable:{question:"Can I customize design of brand-kit files?",answer:"Yes you can enter your contacts, select custom photos, etc. Also you'll have several templates for every marketing materials"},subscriptionResell:{question:"Can I use subscription to resell logos as freelancer?",answer:"Absolutely! You can sell logos, created on Turbologo. Just for a really small price you will have an access to advanced logo editor, vector files and marketing materials. You can return subscription price just from first completed order."}},tips:{logoFileOptions:"Logo file options",platformAccess:"Platform access",brandkit:"Brandkit",unlimitedChanges:{tip:"Make unlimited changes to your logos",title:"Make unlimited changes to your logos",description:"With subscription, you can change and download logo files unlimited times. Start using your logo today and make any changes in the future",li1:"Free unlimited logo changes",li2:"Download logo immediately",li3:"Make any changes online"},unlimitedLogos:{tip:"Create new versions of logo",title:"Create new versions of logo",description:"You can use logo generator to create new versions of logo",li1:"Create new logo designs for free",li2:"Download any logo any time even when subscription ends",li3:"Customize logo design for different platforms"},fullOwnership:{tip:"Full copyright ownership",title1:"Full copyright ownership",description1:"You own full copyright ownership on your logotype. Turbologo transfers your all exclusive rights on logo.",title2:"What is it for?",description2:"Turbologo can't use or reproduce your logo in any way without your agreement."},highQuality:{tip:"High quality logo images and transparent background",title1:"High quality logo images and transparent background",description:"You'll get high quality logo files (2000px), including:",li1:"Logo with original background color",li2:"Logo with transparent background",title2:"What is it for?",li3:"Use logo with transparent background on any image.",li4:"Use high quality logo image on social media services",li5:"Insert your logo into any graphics"},vectorFiles:{tip:"Vector files",title1:"Vector files",description1:"You'll get vector SVG files that can be opened in graphic design software by any designer. This is 'source files' of your logo.",title2:"What is it for?",description2:"Usually designers or typography require vector files. You'll get set of vector files that can be used by any designer or print house.",li1:"Print your logo on any surface and in any size without quality loss",li2:"Use your logo for further design works like signboard, menu, brochure, etc.",li3:"Edit your logo in professional design software, like Photoshop or CorelDraw"},brandIdentity:{tip:"Brand identity",title:"Brand identity",description:"Get full information about fonts and colors used in logo. Additionally download logo in multiple color variations.",li1:"Get logo font names",li2:"Get logo color codes",li3:"Download logo in multiple color variations"},freeSupport:{tip:"Free support",title1:"7 days a week su