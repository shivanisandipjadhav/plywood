yourCoupon:"Kuponunuz: ",couponDescription:"Herhangi bir pakette %5 indirim için bu kupon kodunu uygulayın.",socials:{facebook:"Facebook",twitter:"Twitter",vk:"VK",linkedIn:"LinkedIn"},twitterText:"Qualquer pesoa pode criar um belo logotipo çevrimiçi com Turbologo {ENCODED_URL}. Deney-o de graça"},businessNameGenerator:{form:{title:"Turbologo İşletme Adı Oluşturucu",turbologoReviews:"Turbologo Yorumları",namePlaceholder:"Anahtar kelimeleri girin",industryPlaceholder:"Şirketinizin sektörüne girin",continue:"Devam etmek"},filter:{namePlaceholder:"Anahtar kelimeleri girin",industryPlaceholder:"Şirket endüstrisi",lengthPlaceholder:"Herhangi bir uzunluk",lengthDescription:"Yalnızca 3 ila 20+ karakter adı",length:"{{from}} ila {{to}}",refresh:"Yenile"},namesForLogo:{title:"{{name}} için İsimler"},names:{titles:{invented:"icat edilen isimler",compound:"Bileşik İsimler",multiword:"Çok Kelimeli İsimler"},details:"Ayrıntılara bakınız",more:"Daha fazla göster",empty:"Maalesef mevcut filtre için oluşturulmuş herhangi bir isim yok"},nameCard:{details:{title:"İsim Ayrıntıları",symbols:"{{length}} semboller",createLogo:"Bir logo oluşturun",favorite:"Favori"},domains:{title:"Alan Kullanılabilirliği",seeMore:"Daha fazla alan adı kontrol edin"},logos:{title:"Logo Fikirleri",createLogo:"Daha fazla logo fikri"},alternative:{title:"Alternatif İsimler",seeMore:"Daha fazla alternatif ad görün"},onlineReputation:{title:"Adın Çevrimiçi İtibarını Kontrol Edin"}},favorites:{title:"Favorilerim",empty:"Favorilere isim eklenmemiş"}},reviews:{title:"Musteri degerlendirmeleri"},packages:{coupon:"Kuponu uygula",monthly:"/aylık",yearly:"/yıl",select:"Devam et",additionally:"Pakete ayrıca şunlar dahildir:",oldPrice:"Oldu {{ price }}",economy:"KAYIT ETMEK 50%",see_example:"Örneğe bak",download_example:"Örneği indir",basic:{name:"Lite",description:"Düşük kalitede bir logo"},optima:{name:"Standart",description:"Tüm logo dosyaları + AI hizmetlerine genişletilmiş erişim",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},business:{name:"Kurumsal",description:"Bir iş kurmak için her şey + AI hizmetimize gelişmiş erişim",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},subscription:{paid:"Tasarımınızın ücreti zaten ödendi",info:"Yıllık olarak faturalandırılır",monthly:"/aylık",yearly:"/yıl",save:"{{discount}}% tasarruf edin",select:"Devam et",coupon:"Kuponu uygula",oneTime:"Tek seferlik ödeme",subscription_lite:{name:"Lite",description:"Düşük kalitede bir logo"},subscription_basic:{name:"Standart",description:"Tüm logo dosyaları + AI hizmetlerine genişletilmiş erişim",about:"Hızlı başlangıç için"},subscription_premium:{name:"Kurumsal",description:"Bir iş kurmak için her şey + AI hizmetimize gelişmiş erişim",about:"İşletmeler ve yeni başlayanlar için"}},coupon:{title:"Kuponu uygula",title_applied:"Kupon uygulandı!",code:"Kupon Kodu",button:"Kuponu uygula",close:"Kapat"},faq:{title:"Sıkça Sorulan Sorular",freeDownload:{question:"Ücretsiz bir logo indirebilir miyim?",answer:"Ücretsiz olarak sınırsız logo varyasyonu sağlıyoruz, ancak yalnızca ücretli indirme sunuyoruz. Zaman ve paradan tasarruf edin ve hemen logoyu indirin."},changeLogoAfterPurchase:{question:"Satın aldıktan sonra bir logoyu değiştirebilir miyim?",answer:"Evet, satın aldıktan sonra plan süresi boyunca logoyu sınırsız olarak değiştirebilirsiniz."},createLogoAfterPurchase:{question:"Satın aldıktan sonra daha fazla logo oluşturabilir miyim?",answer:"Evet, sınırsız sayıda logo oluşturabilir ve bunları planınızın şartlarına ve süresine göre indirebilirsiniz. Oluşturduğunuz, değiştirdiğiniz veya indirdiğiniz tüm logolar için tek bir plan geçerlidir"},whatPlanToChooseForPrinting:{question:"Baskı için yüksek kaliteli logolara ihtiyacım varsa hangi planı seçmeliyim?",answer:"Standart ve Kurumsal planlar arasında seçim yapabilirsiniz. Bu planlar, logo dosyalarını yüksek kalitede ve baskı için optimize edilmiş olarak indirmenize olanak tanır."},changeSize:{question:"Satın aldıktan sonra logo boyutunu değiştirebilir miyim?",answer:"Business planını seçerseniz tasarım boyutlarını (genişlik ve yükseklik) değiştirebilirsiniz"},fileFormats:{question:"Hangi formatlar indirilebilir?",answer:"Yüksek kaliteli PNG, vektör SVG ve PDF formatları indirilebilir."},copyright:{question:"Satın aldıktan sonra tüm haklara sahip miyim?",answer:"Evet, düzenleme veya abonelik süresi sona erdiğinde bile tüm ticari haklara sahip olacaksınız."},fontsCommercial:{question:"Logomdaki yazı tiplerini ticari kullanım için kullanabilir miyim?",answer:"Evet, yazı tiplerimiz ticari kullanım için mevcuttur. Marka kiti aboneliğini veya İş paketini seçerseniz yazı tipi adlarını alabilirsiniz."},freeSupport:{question:"Destek veriyor musunuz?",answer:"Evet. Destek ekibimize her gün çevrimiçi sohbet veya e-posta yoluyla ulaşabilirsiniz."},oneTimeFeeVsSubscription:{question:"Tek seferlik ücret ile marka kiti aboneliği arasındaki fark nedir?",answer:"Tek seferlik ücret paketi ile aynı anda sadece bir logo ile çalışabilirsiniz. Marka kiti aboneliği ile ek ücret ödemeden sınırsız sayıda logo oluşturabilir ve indirebilirsiniz."},subscriptionRecurringCharge:{question:"Bu tek seferlik bir ödeme mi?",answer:"Evet. Tek seferlik bir ödemedir ve tekrar etmez."},subscriptionPremiumCustomizable:{question:"Marka kiti dosyalarının tasarımını özelleştirebilir miyim?",answer:"Evet, kişilerinizi girebilir, özel fotoğraflar seçebilirsiniz, vb. Ayrıca her pazarlama materyali için birkaç şablona sahip olacaksınız."},subscriptionResell:{question:"Serbest çalışan olarak logo satmak için aboneliği kullanabilir miyim?",answer:"Kesinlikle! Turbologo'da oluşturulmuş logoları satabilirsiniz. Gerçekten küçük bir fiyata, gelişmiş logo düzenleyiciye, vektör dosyalarına ve pazarlama materyallerine erişebileceksiniz. Tamamlanan ilk siparişten itibaren abonelik ücretini iade edebilirsiniz."}},tips:{logoFileOptions:"Logo dosyası seçenekleri",platformAccess:"Platform erişimi",brandkit:"Marka seti",unlimitedChanges:{tip:"Logolarınızda sınırsız değişiklik yapın",title:"Logolarınızda sınırsız değişiklik yapın",description:"Abonelik ile logo dosyalarını sınırsız kez değiştirebilir ve indirebilirsiniz. Logonuzu bugün kullanmaya başlayın ve gelecekte herhangi bir değişiklik yapın",li1:"Ücretsiz sınırsız logo değişiklikleri",li2:"Logoyu hemen indirin",li3:"Herhangi bir değişikliği çevrimiçi yapın"},unlimitedLogos:{tip:"Logonun yeni sürümlerini oluşturun",title:"Logonun yeni sürümlerini oluşturun",description:"Logonun yeni sürümlerini oluşturmak için logo oluşturucuyu kullanabilirsiniz.",li1:"Ücretsiz yeni logo tasarımları oluşturun",li2:"Abonelik sona erdiğinde bile istediğiniz zaman herhangi bir logoyu indirin",li3:"Logo tasarımını farklı platformlar için özelleştirin"},brandIdentity:{tip:"Marka kimliği",title:"Marka kimliği",description:"Logoda kullanılan yazı tipleri ve renkler hakkında tam bilgi edinin. Ek olarak birden fazla renk varyasyonunda logo indirin.",li1:"Logo yazı tipi adlarını alın",li2:"Logo renk kodlarını alın",li3:"Logoyu birden çok renk varyasyonunda indirin"},socialProfiles:{tip:"Sosyal kapak ve profiller",title:"Sosyal kapak ve profiller",description:"Mükemmel şekilde optimize edilmiş ve özelleştirilebilir sosyal medya profillerine ve kapaklarına anında erişin. Sosyal ağları bugün kullanmaya başlayın",li1:"28+ sosyal medya profil tasarımı",li2:"40'tan fazla mükemmel optimize edilmiş sosyal medya içeriği",li3:"Facebook, Instagram, YouTube, Twitter, Etsy, LinkedIn, VK",li4:"Özelleştirilebilir tasarım",li5:"Çevrimiçi güncelleyin ve indirin"},businessCards:{tip:"Kartvizitler",title:"Kartvizitler",description:"PDF formatında logonuz ve bilgilerinizle birlikte 20'den fazla kişisel ve kartvizit şablonuna anında erişin",li1:"Özelleştirilebilir tasarım",li2:"Logonuz, adınız, pozisyonunuz, kişileriniz ve ek bilgileriniz",li3:"Çevrimiçi güncelleyin ve indirin"},wallpapers:{tip:"Duvar kağıtları",title:"Duvar kağıtları",description:"PNG formatında logonuzla duvar kağıtlarına anında erişin",li1:"Özelleştirilebilir tasarım",li2:"Çevrimiçi güncelleyin ve indirin",li3:"Yüksek kalite"},letterheads:{tip:"Antetli Kağıtlar",title:"Antetli Kağıtlar",description:"PDF ve DOCX formatlarında logonuz ve bilgilerinizin bulunduğu 14+ antetli şablona anında erişin",li1:"Özelleştirilebilir tasarım",li2:"Tasarım logonuzu, adınızı, pozisyonunuzu, iletişim bilgilerinizi ve ek bilgileri içerir",li3:"Çevrimiçi güncelleyin ve indirin",li4:"PDF ve DOCX biçimleri"},envelopes:{tip:"Zarflar",title:"Zarflar",description:"PDF formatında logonuz ve bilgilerinizin bulunduğu çeşitli zarf şablonlarına anında erişin",li1:"Özelleştirilebilir tasarım",li2:"Tasarım logonuzu, adınızı, kişilerinizi ve ek bilgilerinizi içerir",li3:"Çevrimiçi güncelleyin ve indirin"},watermarks:{tip:"Filigranlar",title:"Filigranlar",description:"Logonuzun orijinal ve gri filigranlarını indirin",li1:"Orijinal ve gri renkler",li2:"PNG biçimi",li3:"Çevrimiçi güncellendi"},fullOwnership:{tip:"Tam telif hakkı sahipliği",title1:"Tam telif hakkı sahipliği",description1:"Logonuz üzerindeki tüm ticari ve yaratıcı haklarına sahipsiniz. Turbologo, logo üzerindeki tüm münhasır haklarınızı aktarır.",title2:"Bu ne için?",description2:"Turbologo, logonuzu onayınız olmadan hiçbir şekilde kullanamaz veya çoğaltamaz."},freeSupport:{tip:"Ücretsiz destek",title1:"Haftada 7 gün destek",description1:"E-posta veya canlı sohbet yoluyla size haftanın 7 günü destek sunuyoruz.",title2:"Bu ne için?",description2:"Asla engellere takılmayacaksınız çünkü desteğimiz her soruyu çok hızlı bir şekilde cevaplayacaktır. Şimdi anlamadığınız şeyler için endişelenmeyin, çünkü yardım edebiliriz."},highQuality:{tip:"Yüksek kalitede logo görüntüleri ve şeffaf arka plan",title1:"Yüksek kalitede logo görüntüleri ve şeffaf arka plan",description:"Aşağıdakiler dahil, yüksek kalitede logo dosyaları (2000 piksel) elde edeceksiniz:",li1:"Orijinal arka plan rengine sahip logo",li2:"Şeffaf arka plana sahip logo",title2:"Bu ne için?",li3:"Herhangi bir görüntü üzerinde şeffaf arka plana sahip logo kullanın.",li4:"Sosyal medya hizmetlerinde yüksek kalitede logo görüntüsü kullanın",li5:"Logonuzu herhangi bir grafiğe ekleyin"},vectorFiles:{tip:"Vektörel dosyalar",title1:"Vektörel dosyalar",description1:'Herhangi bir tasarımcı tarafından grafik tasarım yazılımında açılabilen vektörel SVG dosyaları elde edeceksiniz. Bu, logonuzun "kaynak dosyaları"dır.',title2:"Bu ne için?",description2:"Tasarımcılar veya tipografi genellikle vektörel dosyalara ihtiyaç duyar. Herhangi bir tasarımcı veya matbaa tarafından kullanılabilecek bir dizi vektörel dosya alacaksınız.",li1:"Logonuzu istediğiniz bir yüzeye ve istediğiniz boyutta kalite kaybı olmadan yazdırın",li2:"Logonuzu tabela, menü, broşür vb. gibi daha fazla tasarım çalışması için kullanın.",li3:"Logonuzu Photoshop veya CorelDraw gibi profesyonel tasarım yazılımlarında düzenleyin"},oneLogoFile:{tip:"Bir logo dosyası (şeffaf değil)",title1:"Bir logo dosyası",description:"Lite paketi, 1000px genişliğinde PNG formatında bir logo görüntü dosyası içerir. Bu görüntü, önizlemede gördüğünüz ilk resimle aynı görünüyor. Şeffaf arka plana sahip görüntünün bu pakete dahil olmadığını unutmayın.",title2:"Bu ne için?",li1:"Belirli bir görüntü çözünürlüğü veya şeffaf arka plan gerektirmeyen herhangi bir hizmete yükleyin",li2:"Şirketinizin profil resmi olarak yükleyebilirsiniz",li3:"Logonuzun taslağı olarak kullanın ve tasarımcıya gösterin"},freeEditingForThreeMonths:{tip:"3 ay içinde sınırsız değişiklik",title1:"Logoyu sınırsız kez değiştirin",description1:"Logo dosyalarını satın aldıktan sonraki 3 ay içerisinde sınırsız kez değiştirebilir ve indirebilirsiniz.",title2:"Bu ne için?",description2:"Logoyu gerçek hayatta uygulayacağınız zaman herhangi bir parçası değiştirilebilir. Size 3 ay boyunca risksiz, sınırsız logo düzenleyici sunuyoruz. Adı, sloganı, renkleri, yazı tiplerini ve diğer her şeyi ücretsiz değiştirin."},cardBlanksEnvelopes:{tip:"Kartvizitler, antetli kağıt ve zarf",title1:"Logonuzun bulunduğu işletme belgeleri",description1:"Logonuz ve bilgilerinizin bulunduğu markalı belgeleri indirmek için anında erişim sağlayın:",li1:"Logonuz, adınız, konumunuz ve kişilerinizle PDF formatında kişisel ve kartvizit",li2:"Logonuz ve şirket bilgilerinizle birlikte PDF ve DOCX formatlarında antetli kağıtlar",li3:"Şirket bilgilerinizin bulunduğu PDF biçiminde zarflar",li4:"Konferanslarda arka plan olarak kullanmak için PNG'deki duvar kağıtları",description2:"Logoyu veya bilgileri istediğiniz zaman değiştirebilir ve güncellenmiş dosyaları hemen indirebilirsiniz",title2:"Bu ne için?",description3:"İş ve kişisel kartvizitleri yazdırmak için iş paketi dosyalarını kullanabilirsiniz. Firma belgeleri, müşterilerinizin ve ortaklarınızın gözünde şirketinizin güvenilirliğini artıracaktır."},socialKit:{tip:"Sosyal medya kiti",title1:"Sosyal medya kiti",description1:"Facebook, Instagram, YouTube, Etsy, LinkedIn, VK için mükemmel şekilde optimize edilmiş markalı sosyal medya resimlerini ve profillerini indirin",li1:"İş sektörünüze özel logo, marka renkleri ve tasarıma sahip kullanıma hazır kapaklar",li2:"Sosyal profiller için çeşitli logo sürümleri",li3:"Özelleştirilebilir ve anında indirilebilir",li4:"Görüntü boyutları her sosyal ağ için mükemmel şekilde optimize edilmiştir, kırpmanıza veya serbest meslek sahibi tutmanıza gerek yoktur",li5:"Markalı filigranlar",description2:"Bu dosyalar çevrimiçi olarak mevcuttur ve otomatik olarak güncellenir",title2:"Bu ne için?",description3:"Şirketinizin sosyal ağlarda tanıtımını yapmak ve yeni müşteriler edinmek için bu dosyaları kullanın.",description4:"Sosyal ağlar genellikle belirli formatlarda görüntüler gerektirir ve logoyu bu biçime kendi başınıza değiştirmeniz zor olur.",description5:"Kullanıma hazır dosyalar setini alacağınız için farklı platformlar için logo boyutunu değiştirmek için zaman harcamayın."},favicons:{tip:"Web sitesi için site ikonu",title1:"Web sitesi için site ikonu",description1:"Site ikonu, tarayıcı sekmesinde görebileceğiniz küçük bir resimdir.",title2:"Bu ne için?",description2:"Tüm sitelerin benzersiz site ikonları olmalıdır ve siteniz bir istisna değildir. Bu dosyayı işletme paketinin bir parçası olarak edinin."},emailSignatures:{tip:"E-posta imzaları",title:"E-posta imzaları",description:"Logonuz ve şirket bilgilerinizle önceden doldurulmuş markalı e-posta imzaları alın",li1:"özelleştirilebilir tasarım",li2:"Logonuz, adınız, konumunuz, siteniz, iletişim bilgileriniz ve ek bilgileriniz",li3:"HTML kodunu çevrimiçi kopyalayın"},resizeDesign:{tip:"Tasarımları yeniden boyutlandırma",title:"Tasarımları yeniden boyutlandırma",description:"Tasarımlarınızı sosyal medya platformlarında yeniden kullanmak için kolayca yeniden boyutlandırın",li1:"En yaygın tasarım formatlarını kapsar",li2:"Tasarımları herhangi bir boyuta kolayca uyarlayın",li3:"Tasarımları yeniden boyutlandırarak ve herhangi bir formatta çoğaltarak zamandan tasarruf edin"}},payment:{title:"Siparişi Tamamla",tariff:"Paket içeriği",total:"Toplam: ",chooseMethod:"ödeme yöntemini seçin",tariffs:{basic:"Lite",optima:"Standart",business:"Kurumsal",upgrade_to_optima:"Standart pakete yükselt",upgrade_to_business:"İşletme paketine yükselt",social_package:"Sosyal görseller kiti",subscription_lite:"Lite (1 yıl)",subscription_basic:"Standart (1 yıl)",subscription_premium:"Kurumsal (1 yıl)",upgrade_to_subscription_premium:"Brand-kit Premium'a yükseltin:",custom_design:"Özel tasarım saatlik hizmet"},ssl_protected:"256-bit SSL şifreleme ile güvence altına alınmıştır",priceInCurrency:"{{currency}} cinsinden fiyat",cloudpayments:{tab:"Kart",title:"Kart ile ödeme yapın",button:"Ödeme"},stripe_card:{tab:"Kartlar vb.",button:"Ödeme"},paypal:{tab:"PayPal",title:"PayPal ile ödeme yapın",button:"PayPal ile ödeme yapın"},tazapay:{tab:"Pix QR",error:"Ödeme başlatılırken bir hata oluştu. Lütfen diğer yöntemleri deneyin"},error:{title:"Hata, ödeme başarısız oldu",description:"Siparişiniz şu anda