p kinh doanh thành công."},createYourBrand:{title:"Tạo thương hiệu của bạn",description:"Có được thiết kế, logo hoặc thương hiệu đầy đủ độc đáo với hơn 100 giải pháp có sẵn."},turboChatBanner:{title:"Turbochat là mạng nơ-ron miễn phí <span><span>không có VPN</span></span><br/> bằng tiếng Nga giao tiếp như con người",try:"Hãy thử trò chuyện AI",description:"Mạng nơ-ron sẽ cung cấp cho bạn ý tưởng, giúp bạn phát triển, thực hiện các nhiệm vụ nhàm chán, giải phóng thời gian và giải trí cho bạn. Nó sẽ giải thích bằng ngôn ngữ đơn giản."},brandKitLogo:{create:"Logo mới do AI tạo ra",upload:"Tải lên logo của bạn",or:"hoặc",change:"Thay đổi logo"},brandKitMaterialsMenu:{edit:"biên tập",editLogo:"Chỉnh sửa logo",editInfo:"Sửa tên, chức vụ",editPhotos:"Chọn ảnh thương hiệu",photos:"hình ảnh"},downloadPopup:{title:"tải về",descriptionPng:"Chất lượng cao và hỗ trợ nền trong suốt",descriptionPngLite:"Hình ảnh chất lượng cao, hoàn toàn phù hợp với phương tiện truyền thông xã hội",descriptionSvg:"Dành cho thiết kế web và đồ họa vector. Thích hợp để in ấn",descriptionPdf:"Định dạng chung cho tài liệu. Thích hợp để in",titleBackground:"Lý lịch",transparentBackground:"Nền trong suốt",titleSize:"Kích thước hình ảnh",tariffInfo:"Bạn đang sử dụng biểu giá '{{tariff}}'.",tariffLink:"Tìm hiểu thêm về mức giá này",qualityTitle:"Chất lượng hình ảnh",qualityDescription:"Chất lượng cao hơn"},turboChat:{title:"TurboChat",description:"Mạng nơ-ron giúp tạo ý tưởng, viết và hiểu ✨",disclaimer:"Mạng nơ-ron cố gắng nhưng vẫn có thể mắc lỗi. Hãy kiểm tra những điều quan trọng.",disclaimerMobile:"Mạng nơ-ron có thể mắc lỗi. Kiểm tra những điều quan trọng.",copy:"Copy",copied:"Copied",help:{title1:"Tạo tên, khẩu hiệu và mô tả cho thương hiệu",text1:"Đặt tên cho dự án của tôi và tạo một khẩu hiệu cho nó",text2:"Lập kế hoạch nội dung hoặc ý tưởng cho quảng bá",text3:"Viết lời chào cho thương hiệu mà mọi người sẽ nhớ",title2:"Tạo văn bản hoạt động cho thương hiệu trong blog, bản tin và tìm kiếm",text4:"Tạo một email bản tin dẫn đến nhấp chuột",text5:"Tạo văn bản — từ thẻ sản phẩm đến bài đăng",text6:"Viết một bài báo hoặc bài đăng trên blog cho yêu cầu SEO"},input:{placeholder:"Tôi có thể giúp gì cho bạn?"},menu:{history:"lịch sử",rewrite:"Viết lại",refresh:"Làm mới trò chuyện",newChat:"Trò chuyện mới"},messages:{selectTariff:"Chọn giá cước",continue:"Tiếp tục làm việc",tokensEmptyGuest:"Thật đáng tiếc, nhưng giới hạn từ của bạn đã đạt đến 😣 Hãy đăng ký ngay và giới hạn hàng ngày mới của bạn là 5000 từ sẽ có thể sử dụng ngay lập tức!",tokensEmptyNoTariff:"Thật đáng tiếc, nhưng giới hạn từ của bạn đã đạt đến rồi 😣 Vui lòng chọn mức giá phù hợp hoặc đợi đến ngày mai, khi đó giới hạn mới sẽ là 5000 từ.",tokensEmptyTariff:"Wow! Có vẻ như bạn đã sử dụng hết giới hạn từ hàng tháng của mình. Bạn sẽ chỉ có thể sử dụng lại tính năng trò chuyện vào tháng tới khi giới hạn được đặt lại. Nhưng đừng lo lắng, tháng tới sẽ sớm đến thôi 🤗",tokensAvailable:{standard:{month:"Xin chúc mừng! Gói cước Tiêu chuẩn trong 1 tháng đã được kích hoạt và giờ đây bạn sẽ có quyền truy cập vào {{availableWords}} từ mỗi tháng. Trò chuyện không giới hạn ✨",year:"Xin chúc mừng! Gói cước Standard trong 1 năm đã được kích hoạt và giờ đây bạn sẽ có quyền truy cập vào {{availableWords}} từ mỗi tháng. Trò chuyện không giới hạn ✨"},business:{month:"Văn bản tin nhắn: Xin chúc mừng! Gói cước Business trong 1 tháng đã được kích hoạt và giờ đây bạn sẽ có quyền truy cập vào {{availableWords}} từ mỗi tháng. Trò chuyện không giới hạn ✨",year:"Văn bản tin nhắn: Xin chúc mừng! Gói cước Business trong 1 năm đã được kích hoạt và giờ đây bạn sẽ có quyền truy cập vào {{availableWords}} từ mỗi tháng. Trò chuyện không giới hạn ✨"}}},tokens:{text:"Còn lại {{tokens}} yêu cầu trong ngày hôm nay",textTokens:"Bạn có {{tokens}} token",buttons:{signUpAndBuy:"Đăng ký và mua gói cước",buy:"Mua thuế quan",upgrade:"Nâng cấp giá cước",createAccount:"Đóng tài khoản"},tooltipText:"{{left}} trong tổng số {{total}} mã thông báo",toolti