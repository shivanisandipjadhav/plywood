ownload_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},subscription:{paid:"Desain Anda sudah dibayar",info:"Ditagih setiap tahun",monthly:"/mo",yearly:"/ tahun",save:"Hemat {{discount}}%",select:"Lanjutkan",coupon:"Terapkan kupon",oneTime:"Pembayaran satu kali",subscription_lite:{name:"Ringan",description:"Satu logo dalam kualitas rendah",about:"Untuk memulai dengan cepat"},subscription_basic:{name:"Standar",description:"Semua file logo + akses yang diperluas ke layanan AI",about:"Untuk memulai dengan cepat",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},subscription_premium:{name:"Bisnis",description:"Semua yang dibutuhkan untuk memulai bisnis + akses lanjutan ke layanan AI kami",about:"Untuk bisnis dan perusahaan rintisan",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},coupon:{title:"Terapkan kupon",title_applied:"Kupon berlaku!",code:"Kode kupon",button:"Terapkan kupon",close:"Tutup"},faq:{title:"Pertanyaan yang Sering Diajukan",freeDownload:{question:"Dapatkah saya mengunduh logo secara gratis?",answer:"Kami menyediakan variasi logo tak terbatas secara gratis, tetapi kami hanya menawarkan unduhan berbayar. Hemat waktu dan uang Anda dan unduh logo sekarang juga."},changeLogoAfterPurchase:{question:"Dapatkah saya mengubah logo setelah pembelian?",answer:"Ya, Anda dapat mengubah logo tanpa batas setelah pembelian selama periode paket."},createLogoAfterPurchase:{question:"Dapatkah saya membuat lebih banyak logo setelah pembelian?",answer:"Ya, Anda bisa membuat logo dalam jumlah tak terbatas dan mengunduhnya sesuai dengan ketentuan dan jangka waktu paket Anda. Satu paket berlaku untuk semua logo yang Anda buat, ubah, atau unduh"},whatPlanToChooseForPrinting:{question:"Paket mana yang harus saya pilih jika saya membutuhkan logo berkualitas tinggi untuk dicetak?",answer:"Anda bisa memilih antara paket Standar dan Bisnis. Paket-paket ini memungkinkan Anda mengunduh berkas logo dalam kualitas tinggi dan dioptimalkan untuk pencetakan."},changeSize:{question:"Dapatkah saya mengubah ukuran logo setelah pembelian?",answer:"Anda dapat mengubah dimensi desain (lebar dan tinggi) jika Anda memilih paket Bisnis"},fileFormats:{question:"Format apa saja yang tersedia untuk diunduh?",answer:"Format PNG, vektor SVG, dan PDF berkualitas tinggi tersedia untuk diunduh."},copyright:{question:"Apakah saya memiliki semua hak setelah pembelian?",answer:"Ya, Anda akan memiliki hak komersial penuh bahkan setelah waktu pengeditan atau berlangganan berakhir."},fontsCommercial:{question:"Dapatkah saya menggunakan font dari logo saya untuk penggunaan komersial?",answer:"Ya, font kami tersedia untuk penggunaan komersial. Anda bisa mendapatkan nama font jika Anda memilih langganan brand-kit atau paket Bisnis."},freeSupport:{question:"Apakah Anda menawarkan dukungan?",answer:"Ya. Tim dukungan kami tersedia melalui obrolan online atau email setiap hari."},oneTimeFeeVsSubscription:{question:"Apa perbedaan antara biaya satu kali dan langganan brandkit?",answer:"Dengan paket biaya satu kali pakai, Anda bisa bekerja hanya dengan satu logo dalam satu waktu. Dengan langganan brand-kit, Anda bisa membuat dan mengunduh logo versi tak terbatas tanpa biaya tambahan."},subscriptionRecurringCharge:{question:"Apakah ini pembayaran satu kali?",answer:"Ya, ini adalah pembayaran satu kali dan tidak berulang."},subscriptionPremiumCustomizable:{question:"Dapatkah saya menyesuaikan desain file brand-kit?",answer:"Ya, Anda bisa memasukkan kontak Anda, memilih foto khusus, dll. Anda juga akan memiliki beberapa templat untuk setiap materi pemasaran"},subscriptionResell:{question:"Dapatkah saya menggunakan langganan untuk menjual kembali logo sebagai pekerja lepas?",answer:"Tentu saja! Anda bisa menjual logo yang dibuat di Turbologo. Hanya dengan harga yang sangat murah, Anda akan mendapatkan akses ke editor logo tingkat lanjut, file vektor, dan materi pemasaran. Anda bisa mendapatkan kembali harga langganan hanya dari pesanan pertama yang diselesaikan."}},tips:{logoFileOptions:"Opsi file logo",platformAccess:"Akses platform",brandkit:"Brandkit",unlimitedChanges:{tip:"Membuat perubahan tak terbatas pada logo Anda",title:"Membuat perubahan tak terbatas pada logo Anda",description:"Dengan berlangganan, Anda bisa mengubah dan mengunduh file logo tanpa batas. Mulai gunakan logo Anda hari ini dan buat perubahan apa pun di masa mendatang",li1:"Perubahan logo gratis tanpa batas",li2:"Unduh logo segera",li3:"Lakukan perubahan apa pun secara online"},unlimitedLogos:{tip:"Membuat versi baru logo",title:"Membuat versi baru logo",description:"Anda dapat menggunakan generator logo untuk membuat versi baru logo",li1:"Buat desain logo baru secara gratis",li2:"Unduh logo apa pun kapan saja bahkan ketika langganan berakhir",li3:"Menyesuaikan desain logo untuk berbagai platform"},fullOwnership:{tip:"Kepemilikan hak cipta penuh",title1:"Kepemilikan hak cipta penuh",description1:"Anda memiliki hak cipta penuh atas logo Anda. Turbologo mengalihkan semua hak eksklusif Anda atas logo.",title2:"Untuk apa?",description2:"Turbologo tidak dapat menggunakan atau mereproduksi logo Anda dengan cara apa pun tanpa persetujuan Anda."},highQuality:{tip:"Gambar logo berkualitas tinggi dan latar belakang transparan",title1:"Gambar logo berkualitas tinggi dan latar belakang transparan",description:"Anda akan mendapatkan file logo berkualitas tinggi (2000px), termasuk:",li1:"Logo dengan warna latar belakang asli",li2:"Logo dengan latar belakang transparan",title2:"Untuk apa?",li3:"Gunakan logo dengan latar belakang transparan pada gambar apa pun.",li4:"Gunakan gambar logo berkualitas tinggi pada layanan media sosial",li5:"Sisipkan logo Anda ke dalam grafik apa pun"},vectorFiles:{tip:"File vektor",title1:"File vektor",description1:"Anda akan mendapatkan file vektor SVG yang bisa dibuka dalam perangkat lunak desain grafis oleh desainer mana pun. Ini adalah 'file sumber' logo Anda.",title2:"Untuk apa?",description2:"Biasanya desainer atau tipografi membutuhkan file vektor. Anda akan mendapatkan satu set file vektor yang dapat digunakan oleh desainer atau percetakan mana pun.",li1:"Cetak logo Anda di permukaan apa pun dan dalam berbagai ukuran tanpa kehilangan kualitas",li2:"Gunakan logo Anda untuk karya desain lebih lanjut seperti papan nama, menu, brosur, dll.",li3:"Edit logo Anda dalam perangkat lunak desain profesional, seperti Photoshop atau CorelDraw"},brandIdentity:{tip:"Identitas merek",title:"Identitas merek",description:"Dapatkan informasi lengkap tentang font dan warna yang digunakan dalam logo. Selain itu, unduh logo dalam berbagai variasi warna.",li1:"Dapatkan nama font logo",li2:"Dapatkan kode warna logo",li3:"Unduh logo dalam berbagai variasi warna"},freeSupport:{tip:"Dukungan gratis",title1:"Dukungan 7 hari seminggu",description1:"Kami menyediakan dukungan 7 hari seminggu melalui email atau live chat.",title2:"Untuk apa?",description2:"Anda tidak akan pernah terjebak dengan kendala, karena tim dukungan kami akan menjawab pertanyaan apa pun dengan sangat cepat. Jangan khawatir tentang hal-hal yang tidak Anda pahami sekarang, karena kami dapat membantu."},socialProfiles:{tip:"Sampul dan profil sosial",title:"Sampul dan profil sosial",description:"Dapatkan akses instan ke profil dan sampul media sosial yang dioptimalkan dan dapat disesuaikan dengan sempurna. Mulai gunakan jejaring sosial hari ini",li1:"28+ desain profil media sosial",li2:"40+ sampul media sosial yang dioptimalkan dengan sempurna",li3:"Facebook, Instagram, YouTube, Twitter, Etsy, LinkedIn, VK",li4:"Desain yang dapat disesuaikan",li5:"Perbarui dan unduh secara online"},businessCards:{tip:"Kartu nama",title:"Kartu nama",description:"Dapatkan akses instan ke 20+ templat kartu nama dan kartu bisnis dengan logo dan informasi Anda dalam format PDF",li1:"Desain yang dapat disesuaikan",li2:"Logo, nama, posisi, kontak, dan informasi tambahan Anda",li3:"Perbarui dan unduh secara online"},wallpapers:{tip:"Wallpaper",title:"Wallpaper",description:"Dapatkan akses instan ke wallpaper dengan logo Anda dalam format PNG",li1:"Desain yang dapat disesuaikan",li2:"Perbarui dan unduh secara online",li3:"Kualitas tinggi"},letterheads:{tip:"Kop surat",title:"Kop surat",description:"Dapatkan akses instan ke 14+ templat kop surat dengan logo dan informasi Anda dalam format PDF dan DOCX",li1:"Desain yang dapat disesuaikan",li2:"Desain berisi logo, nama, posisi, kontak, dan informasi tambahan Anda",li3:"Perbarui dan unduh secara online",li4:"Format PDF dan DOCX"},envelopes:{tip:"Amplop",title:"Amplop",description:"Dapatkan akses instan ke beberapa templat amplop dengan logo dan informasi Anda dalam format PDF",li1:"Desain yang dapat disesuaikan",li2:"Desain berisi logo, nama, kontak, dan informasi tambahan Anda",li3:"Perbarui dan unduh secara online"},favicons:{tip:"Favicon",title1:"Favicon untuk situs Anda",description1:"Favicon adalah gambar kecil yang dapat Anda lihat pada tab browser.",title2:"Untuk apa?",description2:"Semua situs harus memiliki favicon yang unik dan situs Anda tidak terkecuali. Dapatkan file itu sebagai bagian dari paket bisnis."},watermarks:{tip:"Tanda air",title:"Tanda air",description:"Unduh tanda air asli dan abu-abu dari logo Anda",li1:"Warna asli dan abu-abu",li2:"Format PNG",li3:"Diperbarui secara online"},oneLogoFile:{tip:"Satu file logo (tidak ada file transparan)",title1:"Satu file logo",description:"Paket Lite menyertakan satu file gambar logo dalam format PNG dengan lebar 1000px. Gambar ini terlihat sama seperti yang Anda lihat pada gambar pertama di pratinjau. Perhatikan bahwa gambar dengan latar belakang transparan tidak termasuk dalam paket tersebut.",title2:" Untuk apa?",li1:"Unggah di layanan apa pun yang tidak memerlukan resolusi gambar tertentu atau latar belakang transparan",li2:"Anda dapat mengunggahnya sebagai foto profil perusahaan Anda",li3:"Gunakan sebagai sketsa logo Anda dan tunjukkan kepada desainer"},freeEditingForThreeMonths:{tip:"Perubahan tak terbatas dalam 3 bulan",title1:"Ubah logo berkali-kali tanpa batas",description1:"Anda bisa mengubah dan mengunduh file logo tanpa batas dalam waktu 3 bulan setelah pembelian.",title2:"Untuk apa?",description2:"Setiap bagian dari logo bisa diubah ketika Anda akan menerapkannya dalam kehidupan nyata. Kami memberi Anda editor logo tanpa risiko dan tak terbatas selama 3 bulan."},cardBlanksEnvelopes:{tip:"Kartu nama, kop surat, dan amplop",title1:"Dokumen bisnis dengan logo Anda",description1:"Dapatkan akses instan untuk mengunduh dokumen bermerek dengan logo dan informasi Anda:",li1:"Kartu pribadi dan kartu nama dalam format PDF dengan logo, nama, posisi, dan kontak Anda",li2:"Kop surat dalam format PDF dan DOCX dengan logo dan informasi perusahaan Anda",li3:"Amplop dalam bentuk PDF dengan informasi perusahaan Anda",li4:"Wallpaper dalam PNG untuk digunakan sebagai latar belakang konferensi",description2:"Anda dapat mengubah logo atau informasi kapan saja dan mengunduh file yang diperbarui dengan segera",title2:"Untuk apa?",description3:`Anda dapat menggunakan file paket bisnis untuk mencetak kartu nama dan kartu pribadi.
