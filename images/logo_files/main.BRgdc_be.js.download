er",instagramAndFacebookStories:"Истории для Instagram и Facebook"},brandKitUpgradePopup:{description:"Создание и редактирование всех форматов дизайна доступно в бизнес-плане.",upgrade:"Обновить"},resizeUpgradePopup:{description:"Функция изменения размера доступна в бизнес-плане.",upgrade:"Обновить"},kinds:{custom:"Пользовательский",businessCards:"Бизнес визитка",personalCards:"Персональная визитка",corporateCards:"Корпоративная визитка",envelopes:"Конверт",letterheads:"Бланк",wallpapers:"Обои",facebookCovers:"Facebook обложка",twitterCovers:"Twitter обложка",etsyCovers:"Etsy обложка",vkCovers:"VK обложка",youtubeCovers:"YouTube обложка",linkedinCovers:"LinkedIn обложка",facebookProfiles:"Facebook профиль",instagramProfiles:"Instagram профиль",twitterProfiles:"Twitter профиль",etsyProfiles:"Etsy профиль",vkProfiles:"VK профиль",youtubeProfiles:"YouTube профиль",linkedinProfiles:"LinkedIn профиль",favicons:"Фавиконка",watermarks:"Водяной знак",facebookPosts:"Пост в Facebook",instagramPosts:"Пост в Instagram",twitterPosts:"Пост в Twitter",instagramStories:"История Instagram",emailSignatures:"Подписи для Email",instagramAndFacebookStories:"Instagram and Facebook stories",virtualMultipage:"Многостраничный"},createNew:{title:"Создать новый...",logo:"Логотип",businessCard:"Бизнес визитка",letterhead:"Бланк",youtubeCover:"Обложка Youtube",facebookCover:"Обложка Facebook",other:"Другое"},homeAuthorized:{home:"Главная",myLogos:"Мои логотипы",logos:"Логотипы",myDesigns:"Мои дизайны",designs:"Дизайны",brandkit:"Бренд-кит",website:"Веб-сайт"},userInfo:{brandkit:"Редактировать информацию о компании",upgrade:"Обновить",newDesign:"Создать дизайн",tariffs:{basic:"Лайт",optima:"Стандарт",business:"Бизнес",subscription_lite:"Лайт",subscription_basic:"Стандарт",subscription_premium:"Бизнес"},expired:"Просроченный"},tariffItem:{continue:"Продолжить",upgrade:"Обновить",was:"Было {{amount}}"},tariffSwitcher:{title:"Выберите подходящий пакет файлов и услуг",packages:"На 3 месяца",subscriptions:"На 1 год",save:"Выгода {{discount}}%"},discountShare:{title:"Поделитесь и получите 5% скидку!",description:"Чтобы получить скидку, поделитесь информацией о Turbologo в любой из следующих социальных сетей.",yourCoupon:"Ваш купон: ",couponDescription:"Примените этот код купона для 5% скидки на любой пакет.",socials:{facebook:"Facebook",twitter:"Twitter",vk:"ВКонтакте",linkedIn:"LinkedIn"},twitterText:"Создать логотип с генератором Турболого может каждый {ENCODED_URL}. Попробуйте бесплатно"},businessNameGenerator:{form:{title:"Генератор бизнес-имен Turbologo",turbologoReviews:"Отзывы о Турболого",namePlaceholder:"Введите ключевые слова",industryPlaceholder:"Введите отрасль вашей компании",continue:"Продолжить"},filter:{namePlaceholder:"Введите ключевые слова",industryPlaceholder:"Oтрасль компании",lengthPlaceholder:"Любая длина",lengthDescription:"Только имена от 3 до 20+ символов",length:"От {{from}} до {{to}}",refresh:"Обновить"},namesForLogo:{title:"Названия для {{name}}"},names:{titles:{invented:"Придуманные имена",compound:"Соедененные названия",multiword:"Многословные имена"},details:"Посмотреть детали",more:"Показать еще",empty:"К сожалению, не существует никаких генерируемых имен по текущему фильтру"},nameCard:{details:{title:"Детали имени",symbols:"{{length}} символы",createLogo:"Создать логотип",favorite:"В избранное"},domains:{title:"Доступность доменов",seeMore:"Проверить больше доменов"},logos:{title:"Идеи логотипов",createLogo:"Больше идей логотипов"},alternative:{title:"Альтернативные имена",seeMore:"Посмотреть другие альтернативные названия"},onlineReputation:{title:"Проверьте онлайн-репутацию имени"}},favorites:{title:"Мои избранные имена",empty:"Нет избранных имен"}},reviews:{title:"Отзывы клиентов"},packages:{coupon:"Применить купон",monthly:"/месяц",yearly:"/год",select:"Продолжить",additionally:"Также включено в тариф:",oldPrice:"Было {{ price }}",economy:"ВЫГОДА 50%",see_example:"Посмотреть пример",download_example:"Скачать пример",subscription_lite:{name:"Лайт (1 год)"},basic:{name:"Лайт",description:"Один логотип в низком качестве"},optima:{name:"Стандарт",description:"Все файлы логотипов + расширенный доступ к AI сервисам",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},business:{name:"Бизнес",description:"Всё для старта бизнеса + продвинутый доступ к нашему AI сервису",download_example_url:"https://assets.turbologo.com/turbologo-business-pack-new.zip"}},subscription:{paid:"Ваш дизайн уже оплачен",info:"Оплачивается за год",monthly:"/месяц",yearly:"/год",save:"Выгода {{discount}}%",select:"Продолжить",coupon:"Применить купон",oneTime:"Разовая оплата",subscription_lite:{name:"Лайт",description:"Один логотип в низком качестве",about:"Для старта"},subscription_basic:{name:"Стандарт",description:"Все файлы логотипов + расширенный доступ к AI сервисам",about:"Для старта"},subscription_premium:{name:"Бизнес",description:"Всё для старта бизнеса + продвинутый доступ к нашему AI сервису",about:"Для бизнесов и стартапов"}},coupon:{title:"Применить купон",title_applied:"Купон применен!",code:"Код купона",button:"Применить купон",close:"Закрыть"},faq:{title:"Часто задаваемые вопросы",freeDownload:{question:"Могу ли я скачать логотип бесплатно?",answer:"Бесплатно мы предоставляем неограниченное количество вариантов логотипа, но предлагаем только платную загрузку. Сэкономьте свое время и деньги и скачайте логотип прямо сейчас."},changeLogoAfterPurchase:{question:"Могу ли я изменить логотип после покупки?",answer:"Да, вы можете неограниченно менять логотип после покупки в течение срока действия плана."},createLogoAfterPurchase:{question:"Могу ли я создать больше логотипов после покупки?",answer:"Да, вы можете создавать неограниченное количество логотипов и загружать их в соответствии с условиями и сроком действия вашего тарифного плана. Один тарифный план распространяется на все логотипы, которые вы создаете, изменяете или загружаете"},whatPlanToChooseForPrinting:{question:"Какой тарифный план выбрать, если мне нужны высококачественные логотипы для печати?",answer:'Вы можете выбрать между тарифными планами "Стандарт" и "Бизнес". Эти планы позволят вам загружать файлы логотипов в высоком качестве и оптимизированные для печати.'},changeSize:{question:"Могу ли я изменить размер логотипа после покупки?",answer:'Вы можете изменить размеры дизайна (ширину и высоту), если вы выбрали тарифный план "Бизнес".'},fileFormats:{question:"Какие форматы доступны для скачивания?",answer:"Для загрузки доступны файлы PNG с высоким качеством, векторные SVG и PDF форматы."},copyright:{question:"Обладаю ли я авторскими правами на логотип после покупки?",answer:"Да, вы будете обладать полными коммерческими правами, даже если время редактирования или подписки истекло."},fontsCommercial:{question:"Могу ли я использовать шрифты моего логотипа в коммерческих целях?",answer:"Да, наши шрифты доступны для коммерческого использования. Вы можете получить названия шрифтов, если выберете подписку на фирменный комплект или бизнес-пакет."},freeSupport:{question:"У вас есть онлайн-поддержка?",answer:"Да. Наша служба поддержки доступна через онлайн-чат или по электронной почте каждый день."},oneTimeFeeVsSubscription:{question:"В чем разница между единовременной оплатой и подпиской на фирменный комплект?",answer:"С единовременным тарифом вы можете работать только с одним логотипом одновременно. С подпиской на бренд-кит вы можете создавать и скачивать неограниченное количество версий логотипа без дополнительных затрат."},subscriptionRecurringCharge:{question:"Это единовременный платеж?",answer:"Да. Это разовый платеж, не повторяющийся."},subscriptionPremiumCustomizable:{question:"Можно ли настроить дизайн файлов бренд-кита?",answer:"Да, вы можете ввести свои контакты, выбрать фотографии и т.д. Также у вас будет несколько шаблонов для каждого маркетингового материала."},subscriptionResell:{question:"Могу ли я использовать подписку для перепродажи логотипов как фрилансер?",answer:"Абсолютно! Вы можете продавать логотипы, созданные в Турболого. За очень небольшую цену вы получите доступ к расширенному редактору логотипов, векторным файлам и маркетинговым материалам. Вы можете вернуть стоимость подписки сразу после первого выполненного заказа."}},tips:{logoFileOptions:"Варианты файлов логотипа",platformAccess:"Доступ к платформе",brandkit:"Бренд-кит",unlimitedChanges:{tip:"Создавайте неограниченное количество логотипов",title:"Делайте неограниченное количество изменений в логотипах",description:"С подпиской вы можете изменять и загружать файлы логотипов неограниченное количество раз. Начните использовать свой логотип сегодня и вносите любые изменения в будущем",li1:"Бесплатное неограниченное изменение логотипа",li2:"Загружайте логотип мгновенно",li3:"Вносите любые изменения онлайн"},unlimitedLogos:{tip:"Создавайте новые версии логотипа",title:"Создавайте новые версии логотипа",description:"Вы можете использовать генератор логотипов для создания новых версий логотипа.",li1:"Создавайте новые дизайны логотипов бесплатно",li2:"Загружайте любой логотип в любое время, даже когда подписка закончилась",li3:"Настройте дизайн логотипа для разных платформ"},brandIdentity:{tip:"Фирменный стиль",title:"Фирменный стиль",description:"Получите полную информацию о шрифтах и цветах, используемых в логотипе. Дополнительно загрузите логотип в нескольких цветовых вариантах.",li1:"Получите названия шрифтов логотипа",li2:"Получите цветовые коды логотипа",li3:"Загрузить логотип в нескольких цветовых вариантах"},socialProfiles:{tip:"Обложки и профили для социальных сетей",title:"Обложки и профили для социальных сетей",description:"Получите мгновенный доступ к идеально оптимизированным и настраиваемым профилям и обложкам в социальных сетях. Начните пользоваться социальными сетями сегодня",li1:"28+ дизайнов профилей в социальных сетях",li2:"40+ идеально оптимизированных обложек для социальных сетей",li3:"Facebook, Instagram, YouTube, Twitter, Etsy, LinkedIn, ВКонтакте",li4:"Настраиваемый дизайн",li5:"Обновляйте и скачивайте онлайн"},businessCards:{tip:"Визитки",title:"Визитки",description:"Получите мгновенный доступ к 20+ шаблонам личных и визитных карточек с вашим логотипом и информацией в формате PDF.",li1:"Настраиваемый дизайн",li2:"Ваш логотип, имя, должность, контакты и дополнительная информация",li3:"Обновляйте и скачивайте онлайн"},wallpapers:{tip:"Обои для рабочего стола",title:"Обои для рабочего стола",description:"Получите мгновенный доступ к обоям для рабочего стола с вашим логотипом в формате PNG",li1:"Настраиваемый дизайн",li2:"Обновляйте и скачивайте онлайн",li3:"Высокое качество"},letterheads:{tip:"Фирменные бланки",title:"Фирменные бланки",description:"Получите мгновенный доступ к более чем 14 шаблонам фирменных бланков с вашим логотипом и информацией в форматах PDF и DOCX.",li1:"Настраиваемый дизайн",li2:"Дизайн содержит ваш логотип, имя, должность, контакты и дополнительную информацию.",li3:"Обновляйте и скачивайте онлайн",li4:"Форматы PDF и DOCX"},envelopes:{tip:"Конверты",title:"Конверты",description:"Получите мгновенный доступ к нескольким шаблонам конвертов с вашим логотипом и информацией в формате PDF.",li1:"Настраиваемый дизайн",li2:"Дизайн содержит ваш логотип, имя, контакты и дополнительную информацию.",li3:"Обновляйте и скачивайте онлайн"},watermarks:{tip:"Водяные знаки",title:"Водяные знаки",description:"Скачать оригинальные и серые водяные знаки вашего логотипа",li1:"Оригинальный и серый цвет",li2:"Формат PNG",li3:"Обновляйте и скачивайте онлайн"},fullOwnership:{tip:"Полные авторские и коммерческие права",title1:"Полные авторские и коммерческие права",description1:"Вы владеете полными коммерческими и авторскими правами на логотип. Турболого передает вам эксклюзивные права на использование логотипа в любых целях.",title2:"Для чего это?",description2:"Турболого не может воспроизводить или использовать ваш логотип без вашего соглашения."},freeSupport:{tip:"Бесплатная поддержка",title1:"Онлайн поддержка 7 дней в неделю",description1:"Мы предоставляем онлайн поддержку 7 дней в неделю, без выходных через онлайн чат или электронную почту.",title2:"Для чего это?",description2:"Мы не оставим вас один на один с непонятным набором файлов. Мы ответим на ваши вопросы и всегда поможем. Не беспокойтесь, если какие-то вещи вам сейчас непонятны, потому что мы сможем помочь."},highQuality:{tip:"Файлы логотипа в высоком качестве и с прозрачным фоном ",title1:"Логотип в высоком качестве и с прозрачным фоном",description:"Вы получите набор файлов с высоким качеством изображения (2000px):",li1:"Лого с оригинальным цветом фона",li2:"Лого с прозрачным фоном",title2:"Для чего это?",li3:"Накладывайте файлы с прозрачным фоном на любые изображения",li4:"Используйте высококачественную версию логотипа в социальных сетях",li5:"Используйте логотип в любых графических материалах"},vectorFiles:{tip:"Файлы логотипа в векторном формате",title1:"Векторные файлы",description1:"Вы получите векторные файлы в SVG формате, которые могут быть открыты в графическом приложении любым дизайнером или типографией. Это исходные файлы вашего логотипа, которые подходят для профессионального использования дизайнерами.",title2:"Для чего это?",description2:"Для работы с вашим логотипом дизайнеры или типографии запрашивают логотип в векторном формате. В данной опции включены все векторные файлы.",li1:"Печатайте логотип на любой поверхности и в любом размере без потери качестве (эффекта пиксельности)",li2:"Используйте векторные файлы для дальнейшего дизайна любых графических материалов, таких как вывески, брошюры, меню и т.д.",li3:"Редактируйте логотип в профессиональных программах для дизайна, таких как Photoshop или CorelDraw"},oneLogoFile:{tip:"Один файл логотипа",title1:"Один файл логотипа",description:"Пакет Лайт включает в себя одно изображение вашего логотипа с шириной 1000px. Это тоже самое изображение, что вы можете увидеть первым на странице превью логотипа. Пожалуйста, обратите внимание, что изображение логотипа предоставляется с оригинальным цветом фона (без прозрачного фона).",title2:"Для чего это?",li1:"Загружайте изображение логотипа в онлайн-сервисы, которые не имеют специальных требований к файлу и не требуют прозрачного фона",li2:"Используйте эту картинку, как профиль своей компании",li3:"Набросок логотипа, чтобы показать дизайнеру"},freeEditingForThreeMonths:{tip:"Бесплатное редактирование и повторное скачивание в течение 3 месяцев после оплаты",title1:"Меняйте свой логотип без ограничений",description1:"Вы можете менять и загружать свой логотип неограниченное количество раз в течение 3 месяцев после покупки.",title2:"Для чего это?",description2:"Любая часть логотипа может измениться, когда дойдет до применения его в реальном жизни. Мы даем вам возможность менять свой логотип без каких-либо ограничений. Меняйте название, слоган, шрифт, иконку, цвет или любой другой элемент логотипа бесплатно."},cardBlanksEnvelopes:{tip:"Визитные карточки, фирменный бланк и конверт",title1:"Бизнес-документы с вашим лого и информацией",description1:"Получите доступ к загрузке брендированных документов с вашим лого и информацией:",li1:"Личная и корпоративная визитка в PDF формате с вашим логотипом, именем и контактными данными",li2:"Фирменный бланк в PDF и DOCX форматах с вашим логотипом и данными о компании в колонтитуле",li3:"Фирменный конверт в PDF формате с информацией о компании",li4:"Обои для рабочего стола и конференций",description2:"Меняйте данные или логотип в любой момент и скачивайте обновленные файлы мгновенно",title2:"Для чего это?",description3:`Вы можете использовать эти файлы для печати корпоративной и личной визитки в типографии, а также для отсылки коммерческих предложений клиентам.
 Фирменные документы придадут солидности вашей фирме в глазах клиентов и партнеров.`},socialKit:{tip:"Оформление для соцсетей",title1:"Оформление для соцсетей",description1:"Загрузите брендированное оформление для ВКонтакте, Instagram, Facebook, YouTube, Etsy, LinkedIn",li1:"Готовые для использования обложки с логотипом, фирменными цветами и дизайном, учитывающим сферу деятельности компании",li2:"Несколько варианта оформления профиля для социальных сетей",li3:"Картинки создаются автоматически при обновлении логотипа и доступны для скачивания мгновенно",li4:"Размеры изображений идеально подходят под каждую соцсеть, вам не нужно делать обрезку или нанимать фрилансеров",li5:"Фирменные водяные знаки",description2:"Файлы доступны для загрузки онлайн и обновляются автоматически",title2:"Для чего это?",description3:"Используйте эти файлы для продвижения своей компании в социальных сетях и получения новых клиентов.",description4:"Крайне трудоемко самостоятельно подгонять логотип под требования различных соцсетей и тратить на это драгоценное время.",description5:"Используйте набор готовых файлов, чтобы создать свой фирменный аккаунт за 5 минут."},favicons:{tip:"Фавиконка для вашего сайта",title1:"Фавиконка для вашего сайта",description1:"Фавиконка - это маленькое изображение логотипа сайта, которые отображается на вкладке браузера.",title2:"Для чего это?",description2:"Все сайты должны иметь уникальные фавиконки, чтобы отличаться друг от друга в браузере клиентов. Мы предоставляем этот файл, как часть бизнес-пакета."},emailSignatures:{tip:"Подписи электронной почты",title:"Подписи электронной почты",description:"Получите фирменные подписи электронной почты, с вашим логотипом и информацией о компании",li1:"Настраиваемый дизайн",li2:"Ваш логотип, имя, должность, сайт, контакты и дополнительная информация",li3:"Обновляйте и копируйте онлайн"},resizeDesign:{tip:"Изменение размеров дизайнов",title:"Изменение размеров дизайнов",description:"Легко изменяйте размеры ваших дизайнов, 