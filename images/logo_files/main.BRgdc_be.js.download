ate:"Nuevo logotipo generado por IA",upload:"Cargue su logotipo",or:"o",change:"Cambiar logotipo"},brandKitMaterialsMenu:{edit:"Editar",editLogo:"Editar logotipo",editInfo:"Editar nombre, cargo",editPhotos:"Seleccionar foto de marca",photos:"fotos"},downloadPopup:{title:"Descargar",descriptionPng:"De alta calidad y con fondo transparente",descriptionPngLite:"Imágenes de alta calidad, perfectas para las redes sociales",descriptionSvg:"Para diseño web y gráficos vectoriales. Apto para impresión",descriptionPdf:"Formato universal para documentos. Apto para impresión",titleBackground:"Fondo",transparentBackground:"Fondo transparente",titleSize:"Tamaño de la imagen",tariffInfo:"Estás en la tarifa '{{tariff}}'.",tariffLink:"Más información sobre esta tarifa",qualityTitle:"Calidad de la imagen",qualityDescription:"En mayor calidad"},turboChat:{title:"TurboChat",description:"Una red neuronal que ayuda a generar ideas, escribir y comprender ✨",disclaimer:"La red neuronal lo intenta, pero puede cometer errores. Comprueba las cosas importantes.",disclaimerMobile:"La red neuronal puede cometer errores. Comprueba lo importante.",copy:"Copy",copied:"Copied",help:{title1:"Inventa un nombre, un eslogan y una descripción para la marca",text1:"Nombra mi proyecto e inventa un eslogan para él",text2:"Crea un plan de contenido o una idea para la promoción",text3:"Escribe un saludo para la marca que se recuerde",title2:"Crea textos que funcionen para la marca en blogs, boletines y búsquedas",text4:"Crea un correo para boletines que lleve a un clic",text5:"Crea un texto, desde una ficha de producto hasta una publicación",text6:"Escribe un artículo o una publicación en un blog para una consulta SEO"},input:{placeholder:"¿En qué puedo ayudarle?"},menu:{history:"Historia",rewrite:"Vuelva a escribir",refresh:"Actualizar chat",newChat:"Nuevo chat"},messages:{selectTariff:"Seleccionar tarifa",continue:"Seguir trabajando",tokensEmptyGuest:"Lástima, pero tu límite de palabras ha llegado 😣 ¡Regístrate ahora y tu nuevo límite diario de 5000 palabras estará disponible para usarlo inmediatamente!",tokensEmptyNoTariff:"Lástima, pero su límite de palabras ha llegado a 😣 Por favor, elija una tarifa adecuada, o espere hasta mañana, cuando un nuevo límite de 5000 palabras estará disponible para usted.",tokensEmptyTariff:"¡Vaya! Parece que has agotado tu límite mensual de palabras. Sólo podrás volver a utilizar el chat el mes que viene, cuando se restablezca el límite. Pero no te preocupes, el mes que viene llegará pronto 🤗.",tokensAvailable:{standard:{month:"¡Enhorabuena! La tarifa Estándar para 1 mes ha sido activada, y ahora tendrás acceso a {{availableWords}} palabras cada mes. Chatea sin límites ✨",year:"¡Enhorabuena! La tarifa Estándar por 1 año ha sido activada, y ahora tendrás acceso a {{availableWords}} palabras todos los meses. Chatea sin límites ✨"},business:{month:"Texto del mensaje: ¡Enhorabuena! La tarifa Business para 1 mes ha sido activada, y ahora tendrás acceso a {{availableWords}} palabras cada mes. Chatea sin límites ✨",year:"Texto del mensaje: ¡Enhorabuena! La tarifa Business durante 1 año ha sido activada, y ahora tendrás acceso a {{availableWords}} palabras cada mes. Chatea sin límites ✨"}}},tokens:{text:"Hoy quedan {{tokens}} peticiones",textTokens:"Tienes {{tokens}} ficha(s)",buttons:{signUpAndBuy:"Inscribirse y comprar tarifa",buy:"Comprar tarifa",upgrade:"Tarifa de actualización",createAccount:"Cuenta Ceeate"},tooltipText:"{{left}} de {{total}} fichas",tooltipPopupText:"Usadas {{left}} de {{total}} fichas al día. Más fichas en",tooltipPopupLink:'"en la sección de Tarifas"'},history:{today:"Hoy",yesterday:"Ayer",last7Days:"Últimos 7 días",last30Days:"Últimos 30 días",more:{rename:"Cambie el nombre de",delete:"Borrar",pin:"Pin",unpin:"Desenganche"},months:{january:"Enero",february:"Febrero",march:"Marzo",april:"Abril",may:"Mayo",june:"Junio",july:"Julio",august:"Agosto",september:"Septiembre",october:"Octubre",november:"Noviembre",december:"D