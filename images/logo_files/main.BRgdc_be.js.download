Description:"Áp dụng mã phiếu giảm giá này để được giảm giá 5% cho bất kỳ gói nào.",socials:{facebook:"Facebook",twitter:"Twitter",vk:"VK",linkedIn:"LinkedIn"},twitterText:"Bất kỳ ai cũng có thể tạo biểu trưng đẹp trực tuyến bằng Turbologo {ENCODED_URL}. Dùng thử miễn phí"},businessNameGenerator:{form:{title:"Trình tạo tên doanh nghiệp Turbologo",turbologoReviews:"Đánh giá Turbologo",namePlaceholder:"Nhập từ khóa",industryPlaceholder:"Nhập ngành công ty của bạn",continue:"Tiếp tục"},filter:{namePlaceholder:"Nhập từ khóa",industryPlaceholder:"Công ty Công nghiệp",lengthPlaceholder:"bất kỳ chiều dài",lengthDescription:"Chỉ tên từ 3 đến 20+ ký tự",length:"Từ {{from}} đến {{to}}",refresh:"Làm cho khỏe lại"},namesForLogo:{title:"Tên cho {{name}}"},names:{titles:{invented:"Tên được phát minh",compound:"Tên hợp chất",multiword:"Tên nhiều từ"},details:"Xem chi tiết",more:"Cho xem nhiều hơn",empty:"Rất tiếc, không có bất kỳ tên nào được tạo cho bộ lọc hiện tại"},nameCard:{details:{title:"Tên chi tiết",symbols:"{{length}} ký hiệu",createLogo:"Tạo biểu trưng",favorite:"Yêu thích"},domains:{title:"Tính khả dụng của tên miền",seeMore:"Kiểm tra thêm tên miền"},logos:{title:"Ý tưởng Logo",createLogo:"Ý tưởng logo khác"},alternative:{title:"Tên khác",seeMore:"Xem thêm tên thay thế"},onlineReputation:{title:"Kiểm tra danh tiếng trực tuyến của tên"}},favorites:{title:"Mục yêu thích của tôi",empty:"Không có tên nào được thêm vào mục yêu thích"}},reviews:{title:"Phản hồi khách hàng"},packages:{coupon:"Áp dụng phiếu giảm giá",monthly:"/ tháng",yearly:"/năm",select:"Tiếp tục",additionally:"Cũng bao gồm trong gói:",oldPrice:"Là {{price}}",economy:"TIẾT KIỆM 50%",see_example:"Xem ví dụ",download_example:"Tải xuống ví dụ",subscription_lite:{name:"Lite (1 năm)"},basic:{name:"Lite",description:"Một logo có chất lượng thấp"},optima:{name:"Tiêu chuẩn",description:"Tất cả các tệp logo + quyền truy cập mở rộng vào các dịch vụ AI",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},business:{name:"Việc kinh doanh",description:"Mọi thứ để bắt đầu kinh doanh + quyền truy cập nâng cao vào dịch vụ AI của chúng tôi",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},subscription:{paid:"Thiết kế của bạn đã được thanh toán",info:"Thanh toán hàng năm",monthly:"/ tháng",yearly:"/năm",save:"Tiết kiệm {{discount}}%",select:"Tiếp tục",coupon:"Áp dụng phiếu giảm giá",oneTime:"Thanh toán một lần",subscription_lite:{name:"Lite",description:"Một logo có chất lượng thấp",about:"Để bắt đầu nhanh"},subscription_basic:{name:"Tiêu chuẩn",description:"Tất cả các tệp logo + quyền truy cập mở rộng vào các dịch vụ AI",about:"Để bắt đầu nhanh",download_example_url:"https://assets.turbologo.com/turbologo-standard-pack-new.zip"},subscription_premium:{name:"Việc kinh doanh",description:"Mọi thứ để bắt đầu kinh doanh + quyền truy cập nâng cao vào dịch vụ AI của chúng tôi",about:"Dành cho doanh nghiệp và startup",download_example_url:"http://assets.turbologo.com/turbologo-business-pack-new.zip"}},coupon:{title:"Áp dụng phiếu giảm giá",title_applied:"Phiếu giảm giá được áp dụng!",code:"Mã giảm giá",button:"Áp dụng phiếu giảm giá",close:"Đóng"},faq:{title:"Các câu hỏi thường gặp",freeDownload:{question:"Tôi có thể tải xuống logo miễn phí không?",answer:"Chúng tôi cung cấp miễn phí các biến thể logo không giới hạn, nhưng chúng tôi chỉ cung cấp bản tải xuống có tính phí. Tiết kiệm thời gian và tiền bạc của bạn và tải xuống logo ngay bây giờ."},changeLogoAfterPurchase:{question:"Tôi có thể thay đổi logo sau khi mua không?",answer:"Có, bạn có thể thay đổi logo không giới hạn sau khi mua trong thời gian sử dụng gói."},createLogoAfterPurchase:{question:"Tôi có thể tạo thêm logo sau khi mua không?",answer:"Có, bạn có thể tạo số lượng logo không giới hạn và tải xuống theo các điều khoản và thời hạn của gói dịch vụ của bạn. Một gói dịch vụ áp dụng cho tất cả các logo bạn tạo, thay đổi hoặc tải xuống"},whatPlanToChooseForPrinting:{question:"Tôi nên chọn gói nào nếu cần in logo chất lượng cao?",answer:"Bạn có thể chọn giữa các gói Standard và Business. Các gói này sẽ cho phép bạn tải xuống các tệp logo chất lượng cao và được tối ưu hóa để in."},changeSize:{question:"Tôi có thể thay đổi kích thước logo sau khi mua không?",answer:"Bạn có thể thay đổi kích thước thiết kế (chiều rộng và chiều cao) nếu bạn chọn gói Doanh nghiệp"},fileFormats:{question:"Những định dạng nào có sẵn để tải xuống?",answer:"Định dạng PNG, vector SVG và PDF chất lượng cao có sẵn để tải xuống."},copyright:{question:"Tôi có sở hữu tất cả các quyền sau khi mua không?",answer:"Có, bạn sẽ sở hữu toàn bộ quyền thương mại ngay cả khi hết thời gian chỉnh sửa hoặc đăng ký."},fontsCommercial:{question:"Tôi có thể sử dụng phông chữ từ logo của mình cho mục đích thương mại không?",answer:"Có, phông chữ của chúng tôi có sẵn cho mục đích thương mại. Bạn có thể nhận tên phông chữ nếu bạn chọn đăng ký bộ công cụ thương hiệu hoặc gói Doanh nghiệp."},freeSupport:{question:"Bạn có cung cấp hỗ trợ?",answer:"Đúng. Nhóm hỗ trợ của chúng tôi luôn sẵn sàng thông qua trò chuyện trực tuyến hoặc email mỗi ngày."},oneTimeFeeVsSubscription:{question:"Sự khác biệt giữa phí một lần và đăng ký bộ thương hiệu là gì?",answer:"Với gói phí một lần, bạn có thể làm việc chỉ với một logo tại một thời điểm. Với đăng ký bộ công cụ thương hiệu, bạn có thể tạo và tải xuống các phiên bản logo không giới hạn mà không phải trả thêm phí."},subscriptionRecurringCharge:{question:"Đây có phải là khoản thanh toán một lần không?",answer:"Đúng. Đó là khoản thanh toán một lần và không định kỳ."},subscriptionPremiumCustomizable:{question:"Tôi có thể tùy chỉnh thiết kế của các tập tin bộ thương hiệu không?",answer:"Có, bạn có thể nhập danh bạ của mình, chọn ảnh tùy chỉnh, v.v. Ngoài ra, bạn sẽ có một số mẫu cho mọi tài liệu tiếp thị"},subscriptionResell:{question:"Tôi có thể sử dụng đăng ký để bán lại logo với tư cách là người làm việc tự do không?",answer:"Tuyệt đối! Bạn có thể bán các logo được tạo trên Turbologo. Chỉ với một mức giá thực sự nhỏ, bạn sẽ có quyền truy cập vào trình chỉnh sửa logo, tệp vectơ và tài liệu tiếp thị nâng cao. Bạn có thể trả lại giá đăng ký ngay từ đơn hàng đã hoàn thành đầu tiên."}},tips:{logoFileOptions:"Tùy chọn tệp logo",platformAccess:"Quyền truy cập nền tảng",brandkit:"bộ thương hiệu",unlimitedChanges:{tip:"Thực hiện các thay đổi không giới hạn cho logo của bạn",title:"Thực hiện các thay đổi không giới hạn cho logo của bạn",description:"Với đăng ký, bạn có thể thay đổi và tải xuống các tệp logo không giới hạn số lần. Bắt đầu sử dụng logo của bạn ngay hôm nay và thực hiện bất kỳ thay đổi nào trong tương lai",li1:"Thay đổi logo miễn phí không giới hạn",li2:"Tải xuống logo ngay lập tức",li3:"Thực hiện bất kỳ thay đổi trực tuyến"},unlimitedLogos:{tip:"Tạo các phiên bản logo mới",title:"Tạo các phiên bản logo mới",description:"Bạn có thể sử dụng trình tạo logo để tạo các phiên bản logo mới",li1:"Tạo các thiết kế logo mới miễn phí",li2:"Tải xuống bất kỳ logo nào bất kỳ lúc nào ngay cả khi đăng ký kết thúc",li3:"Tùy chỉnh thiết kế logo cho các nền tảng khác nhau"},fullOwnership:{tip:"Sở hữu bản quyền đầy đủ",title1:"Sở hữu bản quyền đầy đủ",description1:"Bạn sở hữu toàn bộ quyền sở hữu bản quyền đối với logo của mình. Turbologo chuyển giao tất cả các quyền độc quyền của bạn trên logo.",title2:"Nó dùng để làm gì?",description2:"Turbologo không thể sử dụng hoặc sao chép logo của bạn theo bất kỳ cách nào mà không có sự đồng ý của bạn."},highQuality:{tip:"Hình ảnh logo chất lượng cao và nền trong suốt",title1:"Hình ảnh logo chất lượng cao và nền trong suốt",description:"Bạn sẽ nhận được các tệp logo chất lượng cao (2000px), bao gồm:",li1:"Logo có màu nền ban đầu",li2:"Logo có nền trong suốt",title2:"Nó dùng để làm gì?",li3:"Sử dụng logo có nền trong suốt trên bất kỳ hình ảnh nào.",li4:"Sử dụng hình ảnh logo chất lượng cao trên các dịch vụ truyền thông xã hội",li5:"Chèn logo của bạn vào bất kỳ đồ họa nào"},vectorFiles:{tip:"tập tin vectơ",title1:"tập tin vectơ",description1:"Bạn sẽ nhận được các tệp SVG vector có thể được mở trong phần mềm thiết kế đồ họa bởi bất kỳ nhà thiết kế nào. Đây là 'tệp nguồn' logo của bạn.",title2:"Nó dùng để làm gì?",description2:"Thông thường các designer hay typography đều yêu cầu file vector. Bạn sẽ nhận được tập hợp các tệp vectơ có thể được sử dụng bởi bất kỳ nhà thiết kế hoặc nhà in nào.",li1:"In logo của bạn trên mọi bề mặt và ở mọi kích thước mà không làm giảm chất lượng",li2:"Sử dụng logo của bạn cho các công việc thiết kế khác như bảng hiệu, menu, brochure, v.v.",li3:"Chỉnh sửa logo của bạn trong phần mềm thiết kế chuyên nghiệp, như Photoshop hoặc CorelDraw"},brandIdentity:{tip:"nhận diện thương hiệu",title:"nhận diện thương hiệu",description:"Nhận thông tin đầy đủ về phông chữ và màu sắc được sử dụng trong logo. Ngoài ra, hãy tải xuống logo với nhiều biến thể màu sắc.",li1:"Nhận tên phông chữ logo",li2:"Nhận mã màu logo",li3:"Tải xuống logo với nhiều biến thể màu"},freeSupport:{tip:"hỗ trợ miễn phí",title1:"hỗ trợ 7 ngày một tuần",description1:"Chúng tôi cung cấp cho bạn hỗ trợ 7 ngày một tuần qua email hoặc trò chuyện trực tiếp.",title2:"Nó dùng để làm gì?",description2:"Bạn sẽ không bao giờ bị mắc kẹt với những chướng ngại vật, bởi vì bộ phận hỗ trợ của chúng tôi sẽ trả lời mọi câu hỏi rất nhanh. Đừng lo lắng về những điều bạn không hiểu bây giờ, bởi vì chúng tôi có thể giúp đỡ."},socialProfiles:{tip:"Trang bìa và hồ sơ xã hội",title:"Trang bìa và hồ sơ xã hội",description:"Nhận quyền truy cập tức thì vào các trang bìa và hồ sơ truyền thông xã hội được tối ưu hóa và tùy chỉnh hoàn hảo. Bắt đầu sử dụng mạng xã hội ngay hôm nay",li1:"Hơn 28 thiết kế hồ sơ truyền thông xã hội",li2:"Hơn 40 trang bìa truyền thông xã hội được tối ưu hóa hoàn hảo",li3:"Facebook, Instagram, YouTube, Twitter, Etsy, LinkedIn, VK",li4:"thiết kế tùy biến",li5:"Cập nhật và tải xuống trực tuyến"},businessCards:{tip:"Danh thiếp",title:"Danh thiếp",description:"Truy cập ngay vào hơn 20 mẫu danh thiếp cá nhân và danh thiếp có logo và thông tin của bạn ở định dạng PDF",li1:"thiết kế tùy biến",li2:"Logo, tên, vị trí, địa chỉ liên hệ và thông tin bổ sung của bạn",li3:"Cập nhật và tải xuống trực tuyến"},wallpapers:{tip:"hình nền",title:"hình nền",description:"Truy cập ngay vào hình nền có logo của bạn ở định dạng PNG",li1:"thiết kế tùy biến",li2:"Cập nhật và tải xuống trực tuyến",li3:"Chất lượng cao"},letterheads:{tip:"Tiêu đề thư",title:"Tiêu đề thư",description:"Truy cập ngay vào hơn 14 mẫu tiêu đề thư có logo và thông tin của bạn ở định dạng PDF và DOCX",li1:"thiết kế tùy biến",li2:"Thiết kế chứa logo, tên, chức vụ, danh bạ và thông tin bổ sung của bạn",li3:"Cập nhật và tải xuống trực tuyến",li4:"Định dạng PDF và DOCX"},envelopes:{tip:"Bao lì xì",title:"Bao lì xì",description:"Truy cập ngay vào một số mẫu phong bì có logo và thông tin của bạn ở định dạng PDF",li1:"thiết kế tùy biến",li2:"Thiết kế chứa logo, tên, danh bạ và thông tin bổ sung của bạn",li3:"Cập nhật và tải xuống trực tuyến"},favicons:{tip:"biểu tượng yêu thích",title1:"Favicon cho trang web của bạn",description1:"Favicon là hình ảnh nhỏ mà bạn có thể nhìn thấy trên tab trình duyệt.",title2:"Nó dùng để làm gì?",description2:"Tất cả các trang web nên có các biểu tượng yêu thích duy nhất và trang web của bạn cũng không ngoại lệ. Lấy tệp đó như một phần của gói kinh doanh."},watermarks:{tip:"hình mờ",title:"hình mờ",description:"Tải xuống hình mờ gốc và màu xám của logo của bạn",li1:"Màu gốc và màu xám",li2:"định dạng PNG",li3:"Cập nhật trực tuyến"},oneLogoFile:{tip:"Một tệp logo (không có tệp trong suốt)",title1:"Một tập tin logo",description:"Gói Lite bao gồm một tệp hình ảnh logo ở định dạng PNG với chiều rộng 1000px. Hình ảnh này trông giống như hình ảnh đầu tiên khi bạn xem trước. Lưu ý rằng hình ảnh có nền trong suốt không được bao gồm trong gói đó.",title2:"Nó dùng để làm gì?",li1:"Tải nó lên trong bất kỳ dịch vụ nào không yêu cầu độ phân giải hình ảnh cụ thể hoặc nền trong suốt",li2:"Bạn có thể tải nó lên làm ảnh hồ sơ của công ty bạn",li3:"Sử dụng nó làm bản phác thảo logo của bạn và hiển thị nó cho nhà thiết kế"},freeEditingForThreeMonths:{tip:"Thay đổi không giới hạn trong vòng 3 tháng",title1:"Đổi logo không giới hạn số lần",description1:"Bạn có thể thay đổi và tải xuống các tệp logo không giới hạn số lần trong vòng 3 tháng sau khi mua.",title2:"Nó dùng để làm gì?",description2:"Bất kỳ phần nào của logo cũng có thể được thay đổi khi bạn áp dụng nó vào đời thực. Chúng tôi cung cấp cho bạn trình chỉnh sửa logo không giới hạn, không rủi ro trong 3 tháng."},cardBlanksEnvelopes:{tip:"Danh thiếp, tiêu đề thư và phong bì",title1:"Tài liệu kinh doanh có logo của bạn",description1:"Nhận quyền truy cập ngay để tải xuống các tài liệu có thương hiệu với logo và thông tin của bạn:",li1:"Danh thiếp cá nhân và danh thiếp ở định dạng PDF với logo, tên, chức vụ và danh bạ của bạn",li2:"Tiêu đề thư ở định dạng PDF và DOCX với logo và thông tin công ty của bạn",li3:"Phong bì PDF với thông tin công ty của bạn",li4:"Hình nền trong PNG để sử dụng làm nền cho hội nghị",description2:"Bạn có thể thay đổi logo hoặc thông tin bất cứ lúc nào và tải xuống các tệp cập nhật ngay lập tức",title2:"Nó dùng để làm gì?",description3:`Bạn có thể sử dụng các tệp gói doanh nghiệp để in danh thiếp và danh thiếp cá nhân.
Tài liệu chắc chắn sẽ nâng cao uy tín của công ty bạn trong mắt khách hàng và đối tác.`},socialKit:{tip:"Bộ phương tiện truyền thông xã hội",title1:"Bộ phương tiện truyền thông xã hội",description1:"Tải xuống các hình ảnh và hồ sơ truyền thông xã hội có thương hiệu được tối ưu hóa hoàn hảo cho Facebook, Instagram, YouTube, Etsy, LinkedIn, VK",li1:"Bìa sẵn sàng sử dụng với logo, màu sắc thương hiệu và thiết kế phù hợp với ngành kinh doanh của bạn",li2:"Một số phiên bản logo cho hồ sơ xã hội",li3:"Có thể tùy chỉnh và có sẵn để tải xuống ngay lập tức",li4:"Kích thước hình ảnh được tối ưu hóa hoàn hảo cho mọi mạng xã hội, bạn không cần cắt xén hay thuê freelancer",li5:"Hình mờ thương hiệu",description2:"Các tệp này có sẵn trực tuyến và cập nhật tự động",title2:"Nó dùng để làm gì?",description3:"Sử dụng các tệp này để quảng bá công ty của bạn trên các mạng xã hội và có được khách hàng mới.",description4:"Các mạng xã hội thường yêu cầu hình ảnh ở các định dạng cụ thể và bạn sẽ khó tự mình thay đổi logo sang định dạng đó.",description5:"Không mất thời gian thay đổi kích thước logo cho các nền tảng khác nhau vì bạn sẽ nhận được bộ tệp sẵn sàng sử dụng."},emailSignatures:{tip:"chữ ký email",title:"chữ ký email",description:"Nhận chữ ký email có thương hiệu được điền sẵn logo và thông tin công ty của bạn",li1:"thiết kế tùy biến",li2:"Logo, tên, vị trí, trang web, địa chỉ liên hệ và thông tin bổ sung của bạn",li3:"Cập nhật và sao chép trực tuyến"},resizeDesign:{tip:"Thay đổi kích thước thiết kế",title:"Thay đổi kích thước thiết kế",description:"Dễ dàng thay đổi kích thước thiết kế của bạn để sử dụng lại chúng trên các nền tảng truyền thông xã hội",li1:"Bao gồm các định dạng thiết kế phổ biến nhất",li2:"Dễ dàng điều chỉnh thiết kế theo mọi kích thước",li3:"Tiết kiệm thời gian bằng cách thay đổi kích thước và sao chép thiết kế sang bất kỳ định dạng nào"}},payment:{title:"Kết thúc đặt hàng",chooseMethod:"Lựa chọn hình thức thanh toán",tariffs:{basic:"Lite",optima:"Tiêu chuẩn",bus